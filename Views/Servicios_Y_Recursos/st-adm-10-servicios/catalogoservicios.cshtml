  <!-- ═════ HAMBURGER (móvil) ═════ -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Administración</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Catálogo de Servicios</span>
        </nav>
        <h1 class="page-title">Catálogo de Servicios</h1>
        <p class="page-subtitle">Configuración de precios</p>
      </div>
    </header>

    <!-- KPI Cards con aria-live para contadores -->
    <section class="stats-grid" aria-label="Resumen de servicios">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="statTotal" data-target="12" aria-live="polite">0</span>
        <span class="stat-label">Total Servicios</span>
        <span class="stat-sub">Global</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="statActive" data-target="10" aria-live="polite">0</span>
        <span class="stat-label">Servicios Activos</span>
        <span class="stat-sub">↑ +8% vs mes anterior</span>
      </div>
      <div class="stat-card" data-color="red">
        <span class="stat-number" id="statInactive" data-target="2" aria-live="polite">0</span>
        <span class="stat-label">Inactivos / Pausados</span>
        <span class="stat-sub">Sin cambios</span>
      </div>
    </section>

    <!-- Controles y filtros -->
    <section class="controls-section">
      <div class="filters-wrap">
        <div class="search-wrap">
          <span class="search-icon" aria-hidden="true">🔍</span>
          <input type="search" id="searchServices" class="search-input" placeholder="Buscar por nombre..."
            aria-label="Buscar servicio">
        </div>
        <select id="filterCategory" class="filter-select" aria-label="Filtrar por categoría">
          <option value="">Todas las Categorías</option>
          <option value="prevencion">Prevención</option>
          <option value="estetica">Estética</option>
          <option value="cirugia">Cirugía</option>
          <option value="ortodoncia">Ortodoncia</option>
          <option value="endodoncia">Endodoncia</option>
        </select>
        <select id="filterStatus" class="filter-select" aria-label="Filtrar por estado">
          <option value="">Estado: Todos</option>
          <option value="activo">Activo</option>
          <option value="inactivo">Inactivo</option>
        </select>
        <button class="btn-primary" id="btnNewService" aria-label="Crear nuevo servicio">
          ➕ Nuevo servicio
        </button>
      </div>
    </section>

    <!-- Tabla de servicios -->
    <section class="table-section" aria-labelledby="tableTitle">
      <h2 class="visually-hidden" id="tableTitle">Lista de servicios disponibles</h2>

      <!-- Cabecera de tabla accesible -->
      <div class="table-header" role="row">
        <div class="table-col col-nombre" role="columnheader">Nombre del Servicio</div>
        <div class="table-col col-categoria" role="columnheader">Categoría</div>
        <div class="table-col col-duracion" role="columnheader">Duración</div>
        <div class="table-col col-costo" role="columnheader">Costo</div>
        <div class="table-col col-estado text-center" role="columnheader">Estado</div>
        <div class="table-col col-acciones text-right" role="columnheader">Acciones</div>
      </div>

      <!-- Cuerpo de tabla con aria-live -->
      <div id="servicesBody" class="table-body" role="rowgroup" aria-live="polite">
        <!-- Filas inyectadas por JS -->
      </div>

      <!-- Paginación accesible -->
      <footer class="table-footer" aria-label="Navegación de páginas">
        <span>Mostrando <strong id="pageShowing">4</strong> de <strong id="pageTotal">12</strong> servicios</span>
        <nav class="pagination" aria-label="Páginas de resultados">
          <button class="pagination-btn" id="btnPrev" aria-label="Página anterior" disabled>‹</button>
          <button class="pagination-btn active" aria-current="page" aria-label="Página 1">1</button>
          <button class="pagination-btn" aria-label="Página 2">2</button>
          <button class="pagination-btn" aria-label="Página 3">3</button>
          <button class="pagination-btn" id="btnNext" aria-label="Página siguiente">›</button>
        </nav>
      </footer>
    </section>

  </main>

  <!-- Drawer: Editar Servicio (accesible) -->
  <div class="drawer-overlay" id="drawerOverlay" role="dialog" aria-modal="true" aria-labelledby="drawerTitle"
    aria-hidden="true" inert>
    <div class="drawer-panel" id="drawerPanel">
      <header class="drawer-header">
        <h3 class="drawer-title" id="drawerTitle">Editar Servicio</h3>
        <button class="drawer-close" id="drawerClose" aria-label="Cerrar panel">×</button>
      </header>
      <form id="serviceForm" class="drawer-form" role="form">
        <div class="form-group">
          <label for="serviceName" class="form-label">Nombre del Servicio</label>
          <input type="text" id="serviceName" class="form-input" required>
        </div>
        <div class="form-group">
          <label for="serviceDescription" class="form-label">Descripción</label>
          <textarea id="serviceDescription" class="form-textarea" rows="4"></textarea>
        </div>
        <div class="form-group">
          <label for="serviceCategory" class="form-label">Categoría</label>
          <select id="serviceCategory" class="form-select" required>
            <option value="prevencion">Prevención</option>
            <option value="estetica">Estética</option>
            <option value="cirugia">Cirugía</option>
            <option value="ortodoncia">Ortodoncia</option>
            <option value="endodoncia">Endodoncia</option>
          </select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="serviceCost" class="form-label">Costo ($)</label>
            <input type="number" id="serviceCost" class="form-input" step="0.01" min="0" required>
          </div>
          <div class="form-group">
            <label for="serviceDuration" class="form-label">Duración (min)</label>
            <input type="number" id="serviceDuration" class="form-input" min="1" required>
          </div>
        </div>
        <div class="form-group form-toggle">
          <span class="toggle-label">
            <strong>Estado del Servicio</strong>
            <small>Habilitar visibilidad para citas</small>
          </span>
          <button type="button" class="toggle-switch" id="serviceActiveToggle" role="switch" aria-checked="true"
            aria-label="Activar o desactivar servicio">
            <span class="toggle-dot"></span>
          </button>
        </div>
        <footer class="drawer-footer">
          <button type="button" class="btn-secondary" id="drawerCancel">Cancelar</button>
          <button type="submit" class="btn-primary">Guardar Cambios</button>
        </footer>
      </form>
    </div>
  </div>


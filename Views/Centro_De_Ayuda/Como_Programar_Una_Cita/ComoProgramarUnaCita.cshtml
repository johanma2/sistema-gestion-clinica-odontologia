@* Vista sin modelo tipado - datos estáticos *@
@{
    ViewData["Title"] = "Ayuda SmileTrack - Programar Nueva Cita";
    Layout = null; // Cambia esto por tu _Layout.cshtml si esta vista debe usar un layout compartido
}

<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts: Montserrat with Italics -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700;1,800&amp;display=swap" rel="stylesheet"/>
    <!-- Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <!-- Tailwind CSS Play CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "surface": "#f7fafc",
                    "surface-dim": "#d7dadc",
                    "primary-fixed-dim": "#a9c7ff",
                    "inverse-primary": "#a9c7ff",
                    "primary-fixed": "#d6e3ff",
                    "on-tertiary-fixed-variant": "#005313",
                    "on-surface": "#181c1e",
                    "secondary-fixed-dim": "#a2c9ff",
                    "secondary-container": "#1e68b3",
                    "on-tertiary-fixed": "#002204",
                    "on-error-container": "#93000a",
                    "surface-container": "#ebeef0",
                    "surface-container-high": "#e5e9eb",
                    "secondary": "#1e68b3",
                    "background": "#f7fafc",
                    "outline": "#737781",
                    "inverse-on-surface": "#eef1f3",
                    "on-primary-fixed-variant": "#0e4686",
                    "surface-bright": "#f7fafc",
                    "primary-container": "#081c33",
                    "on-secondary-fixed": "#001c38",
                    "on-primary-container": "#83aef5",
                    "on-background": "#181c1e",
                    "tertiary-container": "#004c11",
                    "tertiary-fixed": "#94f990",
                    "on-error": "#ffffff",
                    "surface-container-highest": "#e0e3e5",
                    "error": "#ba1a1a",
                    "surface-variant": "#e0e3e5",
                    "on-tertiary-container": "#5ec160",
                    "secondary-fixed": "#d3e4ff",
                    "surface-tint": "#1e68b3",
                    "on-surface-variant": "#424750",
                    "inverse-surface": "#2d3133",
                    "on-secondary": "#ffffff",
                    "on-primary-fixed": "#001b3d",
                    "on-tertiary": "#ffffff",
                    "surface-container-lowest": "#ffffff",
                    "tertiary": "#003308",
                    "primary": "#081c33",
                    "on-secondary-fixed-variant": "#004881",
                    "outline-variant": "#c3c6d2",
                    "error-container": "#ffdad6",
                    "tertiary-fixed-dim": "#78dc77",
                    "on-primary": "#ffffff",
                    "on-secondary-container": "#ffffff",
                    "surface-container-low": "#f1f4f6"
            },
            "borderRadius": {
                    "DEFAULT": "0.25rem",
                    "lg": "0.5rem",
                    "xl": "0.75rem",
                    "full": "9999px"
            },
            "spacing": {
                    "margin-page": "32px",
                    "gutter": "24px",
                    "base": "4px",
                    "card-padding": "20px",
                    "sidebar-width": "260px"
            },
            "fontFamily": {
                    "label-sm": ["Montserrat"],
                    "headline-lg": ["Montserrat"],
                    "headline-md": ["Montserrat"],
                    "body-md": ["Montserrat"],
                    "headline-lg-mobile": ["Montserrat"],
                    "body-lg": ["Montserrat"],
                    "label-bold": ["Montserrat"],
                    "headline-xl": ["Montserrat"]
            },
            "fontSize": {
                    "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "500"}],
                    "headline-lg": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
                    "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                    "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                    "headline-lg-mobile": ["22px", {"lineHeight": "28px", "fontWeight": "700"}],
                    "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "label-bold": ["12px", {"lineHeight": "16px", "fontWeight": "700"}],
                    "headline-xl": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.5px", "fontWeight": "700"}]
            }
          },
        },
      }
    </script>
    <!-- Custom CSS Stylesheet -->
    <link rel="stylesheet" href="~/css/styles.css"/>
    <!-- Custom JS script -->
    <script src="~/js/script.js" defer></script>
</head>
<body class="bg-[#f4f7fb] min-h-screen flex overflow-hidden text-[#22364f]">
<!-- Fixed Sidebar -->
<aside class="hidden md:flex flex-col w-[260px] bg-gradient-to-b from-[#081c33] via-[#0d3b6f] to-[#125ca5] h-screen text-white shrink-0 sticky top-0 z-50 rounded-r-[28px] shadow-[12px_0_30px_rgba(7,28,51,0.18)] border-r border-white/10">
    <div class="p-6 pb-4">
        <!-- Logo container styled like the image without a solid background -->
        <div class="p-5 flex items-center justify-center mb-6">
            <img class="h-24 w-auto object-contain" src="~/images/logo.jpg" alt="SmileTrack Logo"/>
        </div>
    </div>

    <nav class="flex-1 space-y-2">
        <!-- Panel -->
        <a class="flex items-center gap-3 px-6 py-3.5 rounded-2xl text-white/70 hover:bg-white/10 hover:text-white transition-all" asp-controller="Dashboard" asp-action="Index">
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="4" y="4" width="7" height="7" rx="1.5" fill="#4ade80"/>
                <rect x="13" y="4" width="7" height="7" rx="1.5" fill="#3b82f6"/>
                <rect x="4" y="13" width="7" height="7" rx="1.5" fill="#f472b6"/>
                <rect x="13" y="13" width="7" height="7" rx="1.5" fill="#eab308"/>
            </svg>
            <span class="font-body-md text-body-md font-medium">Panel</span>
        </a>

        <!-- Pacientes -->
        <a class="flex items-center gap-3 px-6 py-3.5 rounded-2xl text-white/70 hover:bg-white/10 hover:text-white transition-all" asp-controller="Patients" asp-action="Index">
            <svg class="w-5 h-5 shrink-0 text-purple-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </svg>
            <span class="font-body-md text-body-md font-medium">Pacientes</span>
        </a>

        <!-- Citas (activo: esta guía pertenece a la sección de Citas) -->
        <a class="flex items-center gap-3 pl-5 pr-6 py-3.5 rounded-2xl bg-[#1e68b3] text-white border-l-4 border-white font-bold transition-all" asp-controller="Appointments" asp-action="Index">
            <svg class="w-5 h-5 shrink-0 text-white" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/>
            </svg>
            <span class="font-body-md text-body-md font-bold">Citas</span>
        </a>

        <!-- Facturas -->
        <a class="flex items-center gap-3 px-6 py-3.5 rounded-2xl text-white/70 hover:bg-white/10 hover:text-white transition-all" asp-controller="Invoices" asp-action="Index">
            <svg class="w-5 h-5 shrink-0 text-gray-300" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
            </svg>
            <span class="font-body-md text-body-md font-medium">Facturas</span>
        </a>

        <!-- Recordatorios -->
        <a class="flex items-center gap-3 px-6 py-3.5 rounded-2xl text-white/70 hover:bg-white/10 hover:text-white transition-all" asp-controller="Reminders" asp-action="Index">
            <svg class="w-5 h-5 shrink-0 text-yellow-400" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/>
            </svg>
            <span class="font-body-md text-body-md font-medium">Recordatorios</span>
        </a>
    </nav>

    <!-- Footer (Recepcionista Card styled like the first image) -->
    <div class="mt-auto border-t border-white/10 p-6">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#1e68b3] flex items-center justify-center font-bold text-white shrink-0">
                @Model.User.Initials
            </div>
            <div class="overflow-hidden">
                <p class="font-label-bold text-label-bold text-white font-bold leading-tight">@Model.User.FullName</p>
                <p class="text-[10px] text-white/70 truncate">@Model.User.Email</p>
            </div>
        </div>
    </div>
</aside>

<!-- Main Content Canvas -->
<main class="flex-1 h-screen overflow-y-auto scroll-smooth">
    <!-- Header / TopAppBar Component Logic Mapping -->
    <header class="sticky top-0 z-40 flex justify-between items-center px-margin-page py-4 w-full bg-white/95 backdrop-blur-sm border-b border-slate-200 shadow-[0_8px_24px_rgba(15,39,71,0.06)]">
        <div class="flex items-center gap-4">
            <button class="md:hidden p-2 rounded-full hover:bg-surface-container-high transition-colors active:scale-95 duration-100">
                <span class="material-symbols-outlined text-secondary">menu</span>
            </button>
            <div class="flex flex-col">
                <h1 class="font-headline-md text-headline-md font-bold text-[#0d3b6f]">Centro de Ayuda</h1>
                <span class="text-[12px] text-on-surface-variant">Guía de usuario SmileTrack</span>
            </div>
        </div>
        <div class="flex items-center gap-4">
            <div class="relative hidden sm:block">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline-variant">search</span>
                <input class="pl-10 pr-4 py-2 bg-surface-container border-none rounded-full w-64 focus:ring-2 focus:ring-secondary transition-all" placeholder="Buscar ayuda..." type="text"/>
            </div>
            <button class="p-2 rounded-full hover:bg-surface-container-high transition-colors active:scale-95 duration-100">
                <span class="material-symbols-outlined text-secondary">notifications</span>
            </button>
        </div>
    </header>

    <div class="p-margin-page max-w-6xl mx-auto py-6">
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 mb-8 text-on-surface-variant font-label-sm text-label-sm">
            <a class="hover:text-secondary" asp-controller="Home" asp-action="Index">Inicio</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <a class="hover:text-secondary" asp-controller="HelpCenter" asp-action="Index">Ayuda</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-secondary font-bold">@Model.Title</span>
        </nav>

        <!-- Article Body (Bento Style) -->
        <div class="bento-grid">
            <!-- Main Content Section -->
            <div class="col-span-12 lg:col-span-8 space-y-gutter">
                <!-- Article Title Card -->
                <article class="bg-white rounded-[24px] p-card-padding shadow-[0_10px_32px_rgba(15,39,71,0.08)] border border-slate-200">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="p-3 rounded-xl bg-secondary/10 text-secondary">
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">calendar_add_on</span>
                        </div>
                        <h2 class="font-headline-lg text-headline-lg text-primary">@Model.Title</h2>
                    </div>
                    <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 leading-relaxed">
                        @Model.Introduction
                    </p>

                    <!-- Video Tutorial Placeholder -->
                    <div class="relative w-full aspect-video rounded-xl overflow-hidden group cursor-pointer mb-10 shadow-md">
                        <img class="w-full h-full object-cover" alt="@Model.VideoAltText" src="@Model.VideoThumbnailUrl"/>
                        <div class="absolute inset-0 video-overlay flex items-center justify-center transition-all group-hover:bg-black/30">
                            <div class="w-20 h-20 rounded-full bg-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform">
                                <span class="material-symbols-outlined text-secondary text-5xl" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                            </div>
                        </div>
                        <div class="absolute bottom-4 left-4 bg-black/60 backdrop-blur-md px-3 py-1 rounded-full flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-error animate-pulse"></span>
                            <span class="text-white text-xs font-bold uppercase tracking-wider">Tutorial de Video</span>
                        </div>
                    </div>

                    <!-- Step-by-Step Guide -->
                    <div class="space-y-8">
                        <h3 class="font-headline-md text-headline-md text-primary flex items-center gap-2">
                            <span class="material-symbols-outlined text-secondary">format_list_numbered</span>
                            Guía paso a paso
                        </h3>
                        <div class="grid gap-6">
                            @foreach (var step in Model.Steps)
                            {
                                <div class="flex gap-6 group">
                                    <div class="shrink-0 w-12 h-12 rounded-full bg-surface-container-highest flex items-center justify-center font-bold text-secondary text-xl border-2 border-transparent group-hover:border-secondary transition-all">
                                        @step.Number
                                    </div>
                                    <div class="flex-1 pt-2">
                                        <h4 class="font-headline-md text-headline-md text-on-surface mb-2">@step.Title</h4>
                                        <p class="font-body-md text-body-md text-on-surface-variant">
                                            @Html.Raw(step.DescriptionHtml)
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Footer Actions -->
                    <div class="mt-12 pt-8 border-t border-outline-variant/30 flex flex-col md:flex-row justify-between items-center gap-6">
                        <div class="flex items-center gap-4">
                            <button id="prevButton" type="button" class="flex items-center gap-2 px-6 py-2.5 rounded-full border border-secondary text-secondary font-bold hover:bg-secondary/5 transition-all">
                                <span class="material-symbols-outlined">chevron_left</span>
                                Anterior
                            </button>
                            <button id="nextButton" type="button" class="flex items-center gap-2 px-6 py-2.5 rounded-full bg-secondary text-white font-bold hover:bg-primary shadow-lg shadow-secondary/20 transition-all">
                                Siguiente
                                <span class="material-symbols-outlined">chevron_right</span>
                            </button>
                        </div>
                        <div class="flex flex-col gap-3 bg-surface-container p-3 px-6 rounded-2xl">
                            <div class="flex items-center gap-6">
                                <p class="font-label-bold text-label-bold text-on-surface-variant">¿Te resultó útil?</p>
                                <div class="flex gap-3">
                                    <button class="rating-button w-10 h-10 rounded-full bg-white flex items-center justify-center text-green-600 hover:scale-110 active:scale-95 transition-all shadow-sm" data-rating="success">
                                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">thumb_up</span>
                                    </button>
                                    <button class="rating-button w-10 h-10 rounded-full bg-white flex items-center justify-center text-error hover:scale-110 active:scale-95 transition-all shadow-sm" data-rating="error">
                                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">thumb_down</span>
                                    </button>
                                </div>
                            </div>
                            <div id="ratingResponseBox" class="hidden rounded-2xl bg-emerald-50 border border-emerald-200 p-3 text-sm font-medium text-emerald-900">
                                Respuesta exitosa
                            </div>
                        </div>
                    </div>
                </article>
            </div>

            <!-- Sidebar Content Section -->
            <div class="col-span-12 lg:col-span-4 space-y-gutter">
                <!-- Search & Filters -->
                <div class="bg-surface-container-lowest rounded-xl p-card-padding shadow-[0px_4px_20px_rgba(0,0,0,0.08)]">
                    <h3 class="font-headline-md text-headline-md text-primary mb-4">Temas relacionados</h3>
                    <div class="space-y-3">
                        @foreach (var topic in Model.RelatedTopics)
                        {
                            <button type="button" class="related-topic-button flex w-full items-center justify-between p-3 rounded-lg hover:bg-surface-container transition-colors group text-left" data-topic="@topic">
                                <span class="font-body-md text-body-md text-on-surface-variant group-hover:text-secondary">@topic</span>
                                <span class="material-symbols-outlined text-[18px] opacity-0 group-hover:opacity-100 transition-opacity">arrow_forward</span>
                            </button>
                        }
                    </div>
                </div>

                <!-- Alerts / Quick Help -->
                <div class="bg-primary rounded-xl p-card-padding shadow-xl text-white relative overflow-hidden">
                    <!-- Decorative circle -->
                    <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-white/10 rounded-full"></div>
                    <div class="relative z-10">
                        <span class="material-symbols-outlined mb-4" style="font-variation-settings: 'FILL' 1;">live_help</span>
                        <h3 class="font-headline-md text-headline-md mb-2">¿Necesitas soporte técnico?</h3>
                        <p class="font-body-md text-body-md opacity-80 mb-6">Estamos aquí para ayudarte. Nuestro equipo responde en menos de 10 minutos.</p>
                        <button id="supportButton" type="button" class="w-full py-3 bg-secondary-container text-white font-bold rounded-xl hover:bg-white hover:text-secondary transition-all">
                            Hablar con Soporte
                        </button>
                    </div>
                </div>

                <!-- Tags -->
                <div class="bg-surface-container-lowest rounded-xl p-card-padding shadow-[0px_4px_20px_rgba(0,0,0,0.08)]">
                    <h3 class="font-headline-md text-headline-md text-primary mb-4">Etiquetas</h3>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var tag in Model.Tags)
                        {
                            <span class="px-3 py-1 bg-surface-container rounded-full text-[12px] font-medium text-on-surface-variant">#@tag</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Topic modal -->
    <div id="topicModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/40 p-4">
        <div class="max-w-lg w-full bg-white rounded-[28px] shadow-[0_28px_80px_rgba(15,39,71,0.18)] border border-slate-200 overflow-hidden">
            <div class="flex items-center justify-between px-6 py-5 border-b border-slate-200">
                <h3 id="modalTitle" class="font-headline-md text-headline-md font-bold text-slate-900">Título del tema</h3>
                <button id="modalCloseBtn" type="button" class="rounded-full p-2 text-slate-500 hover:bg-slate-100 transition">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-6">
                <p id="modalDescription" class="font-body-md text-body-md text-slate-700 leading-7">
                    Aquí puedes ver más detalles relacionados con el tema seleccionado.
                </p>
                <div class="mt-6 rounded-3xl bg-surface-container-lowest p-4 border border-slate-200">
                    <p class="font-label-bold text-label-bold text-slate-600">Consejo:</p>
                    <p id="modalAdvice" class="mt-2 text-sm text-slate-600">Selecciona la opción de soporte y explica brevemente tu problema para recibir ayuda más rápida.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- Spacer for BottomNavBar on Mobile -->
    <div class="h-20 md:hidden"></div>
</main>

<!-- Bottom Navigation for Mobile -->
<nav class="md:hidden fixed bottom-0 w-full z-50 bg-surface-container-lowest dark:bg-inverse-surface flex justify-around items-center h-16 px-4 border-t border-outline-variant shadow-[0px_-4px_20px_rgba(0,0,0,0.05)]">
    <button class="flex flex-col items-center justify-center text-on-surface-variant hover:text-secondary transition-transform active:scale-90">
        <span class="material-symbols-outlined">help_center</span>
        <span class="font-label-sm text-label-sm">Ayuda</span>
    </button>
    <button class="flex flex-col items-center justify-center text-on-surface-variant hover:text-secondary transition-transform active:scale-90">
        <span class="material-symbols-outlined">play_circle</span>
        <span class="font-label-sm text-label-sm">Videos</span>
    </button>
    <button class="flex flex-col items-center justify-center bg-secondary-container text-white rounded-xl px-3 py-1 transition-transform active:scale-90">
        <span class="material-symbols-outlined">menu_book</span>
        <span class="font-label-sm text-label-sm">Tópicos</span>
    </button>
    <button class="flex flex-col items-center justify-center text-on-surface-variant hover:text-secondary transition-transform active:scale-90">
        <span class="material-symbols-outlined">account_circle</span>
        <span class="font-label-sm text-label-sm">Perfil</span>
    </button>
</nav>

<!-- Custom JS script -->
<script src="~/js/app.js" defer></script>
</body>
</html>

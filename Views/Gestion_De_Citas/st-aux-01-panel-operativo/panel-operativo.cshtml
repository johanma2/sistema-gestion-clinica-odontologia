@{ Layout = null; }

﻿<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmileTrack — Panel Operativo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_Citas/st-aux-01-panel-operativo/panel-operativo.css")" />
</head>

<body>

  <!-- Enlace para saltar al contenido principal, accesibilidad keyboard-first -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <!-- ═════ SIDEBAR UNIFICADO (Activo: Panel operativo) ═════ -->
  <aside class="sidebar" id="sidebar" aria-label="Navegación principal">
  <div class="sidebar-logo">
    <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="SmileTrack" class="logo-img" />
  </div>
  @{ await Html.RenderPartialAsync("_SidebarAuxiliar"); }
    <div class="sidebar-user">
      <div class="user-avatar" aria-hidden="true">@(User.Identity?.Name?.Substring(0, 2).ToUpperInvariant() ?? "U")</div>
      <div class="user-info">
        <span class="user-role">@User.Identity?.Name</span>
        <span class="user-email">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
      </div>
    </div>
</aside>

  <!-- Botón hamburguesa para menú móvil, con atributos ARIA para accesibilidad -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Page header -->
    <header class="page-header">
      <div class="header-left">
        <div class="breadcrumb">Auxiliar → Panel operativo</div>
        <h1 class="page-title">Panel operativo</h1>
        <p class="page-subtitle" id="pageMeta">Resumen en tiempo real</p>
      </div>
      <button class="btn-primary" id="btnDescargar" aria-label="Descargar resumen del panel">💾 Descargar
        resumen</button>
    </header>

    <!-- Alerta próxima cita con role status para anuncio dinámico -->
    <div class="alerta-proxima" role="status" aria-live="polite">
      <span class="alerta-proxima-icon" aria-hidden="true">⏰</span>
      <div class="alerta-proxima-content">
        <p class="alerta-proxima-title" id="apTitulo"></p>
        <p class="alerta-proxima-desc" id="apDetalle"></p>
      </div>
    </div>

    <!-- KPIs con aria-label para sección de métricas -->
    <div class="kpi-grid" id="kpiGrid" aria-label="Métricas clave del panel"></div>

    <!-- Barra de progreso con aria-valuenow para accesibilidad -->
    <div class="progreso-wrap">
      <div class="progreso-bar-bg" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
        aria-label="Progreso de citas completadas">
        <div class="progreso-bar-fill" id="progresoBarra"></div>
      </div>
      <span class="progreso-label" id="progresoLabel"></span>
    </div>

    <!-- Grid inferior: Tabla + Alertas -->
    <div class="grid-bottom">

      <!-- Tabla de citas con aria-label y scope en headers -->
      <div class="table-wrap">
        <table class="table-base" aria-label="Listado de citas del día">
          <thead>
            <tr>
              <th scope="col">Hora</th>
              <th scope="col">Paciente</th>
              <th scope="col">Profesional</th>
              <th scope="col">Alergias</th>
              <th scope="col">Consultorio</th>
              <th scope="col">Estado</th>
              <th scope="col"><span class="visually-hidden">Acciones</span></th>
            </tr>
          </thead>
          <tbody id="citasBody" aria-live="polite"></tbody>
        </table>
      </div>

      <!-- Panel de alertas con role list -->
      <aside class="alertas-card" aria-labelledby="alertasTitle">
        <h3 class="alertas-title" id="alertasTitle">⚠️ Alertas del día</h3>
        <div class="alertas-list" id="alertasList" role="list" aria-label="Lista de alertas importantes"></div>
      </aside>

    </div>

  </main>

  <!-- ═══ MODAL PACIENTE ═══ -->
  <div class="modal-backdrop" id="modalBackdrop" role="dialog" aria-modal="true" aria-labelledby="modalTitle"
    aria-hidden="true" inert>
    <div class="modal" id="modalPaciente">
      <div class="modal-header">
        <div style="display:flex;align-items:center;gap:12px;">
          <div class="modal-avatar" id="modalAvatar" aria-hidden="true"></div>
          <div>
            <h2 class="modal-name" id="modalTitle"></h2>
            <p class="modal-role" id="modalRole"></p>
          </div>
        </div>
        <button class="modal-close" id="modalCloseBtn" aria-label="Cerrar modal">×</button>
      </div>

      <div class="modal-body">
        <!-- Info básica -->
        <div class="modal-info-grid">
          <div class="modal-info-item">
            <span class="modal-info-icon" aria-hidden="true">📞</span>
            <div>
              <p class="modal-info-label">Teléfono</p>
              <p class="modal-info-value" id="modalTelefono"></p>
            </div>
          </div>
          <div class="modal-info-item">
            <span class="modal-info-icon" aria-hidden="true">✉️</span>
            <div>
              <p class="modal-info-label">Email</p>
              <p class="modal-info-value" id="modalEmail"></p>
            </div>
          </div>
          <div class="modal-info-item">
            <span class="modal-info-icon" aria-hidden="true">🩸</span>
            <div>
              <p class="modal-info-label">Grupo sanguíneo</p>
              <p class="modal-info-value" id="modalSangre"></p>
            </div>
          </div>
          <div class="modal-info-item">
            <span class="modal-info-icon" aria-hidden="true">🎂</span>
            <div>
              <p class="modal-info-label">Edad</p>
              <p class="modal-info-value" id="modalEdad"></p>
            </div>
          </div>
        </div>

        <!-- Alergias -->
        <div class="modal-section">
          <p class="modal-section-title">⚠️ Alergias</p>
          <span class="modal-alergia-tag" id="modalAlergias" role="status"></span>
        </div>

        <!-- Medicamentos -->
        <div class="modal-section">
          <p class="modal-section-title">💊 Medicamentos actuales</p>
          <div class="modal-medicamentos" id="modalMedicamentos" role="list" aria-label="Lista de medicamentos"></div>
        </div>

        <!-- Antecedentes -->
        <div class="modal-section">
          <p class="modal-section-title">📋 Antecedentes</p>
          <p class="modal-antecedentes" id="modalAntecedentes"></p>
        </div>

        <!-- Cita actual -->
        <div class="modal-section modal-cita-actual">
          <p class="modal-section-title">📅 Cita actual</p>
          <div class="modal-cita-info">
            <div class="modal-cita-row">
              <span class="modal-cita-label">Servicio:</span>
              <span class="modal-cita-value" id="modalServicio"></span>
            </div>
            <div class="modal-cita-row">
              <span class="modal-cita-label">Profesional:</span>
              <span class="modal-cita-value" id="modalProfesional"></span>
            </div>
            <div class="modal-cita-row">
              <span class="modal-cita-label">Consultorio:</span>
              <span class="modal-cita-value" id="modalConsultorio"></span>
            </div>
            <div class="modal-cita-row">
              <span class="modal-cita-label">Hora:</span>
              <span class="modal-cita-value" id="modalHora"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="modal-btn modal-btn-secondary" id="modalCloseBtn2">Cerrar</button>
        <button class="modal-btn modal-btn-primary" id="modalVerHistoria">Ver historia clínica</button>
      </div>
    </div>
  </div>

  <!-- Toast con aria-atomic para anuncio completo de notificaciones -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para contenido solo accesible por screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;">🦷</span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>


  <script src="@Url.Content("~/js/Gestion_De_Citas/st-aux-01-panel-operativo/panel-operativo.js")"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.nav-group-header').forEach(header => {
      const items = header.nextElementSibling;
      const arrow = header.querySelector('.nav-arrow');

      if (!items || !arrow) return;

      const setExpanded = (isExpanded) => {
        items.style.maxHeight = isExpanded ? `${items.scrollHeight}px` : '0px';
        arrow.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
        header.setAttribute('aria-expanded', String(isExpanded));
      };

      setExpanded(false);

      const toggle = () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        setExpanded(!isExpanded);
      };

      header.addEventListener('click', toggle);
      header.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  });
</script>

</body>

</html>



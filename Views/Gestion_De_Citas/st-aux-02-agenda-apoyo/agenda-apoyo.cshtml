@{ Layout = null; }

﻿<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmileTrack — Agenda de Apoyo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_Citas/st-aux-02-agenda-apoyo/agenda-apoyo.css")" />
</head>

<body>

  <!-- Enlace para saltar al contenido principal, accesibilidad keyboard-first -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

@{ await Html.RenderPartialAsync("_SidebarAuxiliar"); }

  <!-- Botón hamburguesa para menú móvil, con atributos ARIA para accesibilidad -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Page header con metadatos accesibles -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Auxiliar</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Agenda</span>
        </nav>
        <h1 class="page-title">Agenda de Apoyo Clínico</h1>
        <p class="page-subtitle" id="phMeta" aria-live="polite">Citas del día que requieren asistencia</p>
      </div>
    </header>

    <!-- Contenido principal -->
    <div class="content">

      <!-- Barra de filtros con role toolbar y accesibilidad -->
      <div class="filtros-bar" role="toolbar" aria-label="Filtros de agenda">

        <!-- Dropdown profesional accesible -->
        <div class="dropdown-wrap">
          <button class="filter-btn filter-dropdown" id="btnProfesional" aria-haspopup="true" aria-expanded="false"
            aria-controls="dropdownMenu">
            Todos los profesionales <span class="dd-arrow" aria-hidden="true">▼</span>
          </button>
          <div class="dropdown-menu" id="dropdownMenu" role="menu" aria-label="Seleccionar profesional">
            <div class="dd-item active" role="menuitem" tabindex="0" data-value="todos">Todos los profesionales</div>
            <div class="dd-item" role="menuitem" tabindex="0" data-value="mendez">Dr. Méndez</div>
            <div class="dd-item" role="menuitem" tabindex="0" data-value="ramirez">Dra. Ramírez</div>
            <div class="dd-item" role="menuitem" tabindex="0" data-value="gomez">Dra. Gómez</div>
          </div>
        </div>

        <!-- Filtros de tipo con role radiogroup -->
        <div role="radiogroup" aria-label="Filtrar por tipo de cita" class="filter-group">
          <button class="filter-btn active" id="f-todos" role="radio" aria-checked="true" data-value="todos">Todos los
            tipos</button>
          <button class="filter-btn tipo-consulta" id="f-consulta" role="radio" aria-checked="false"
            data-value="consulta">Consulta</button>
          <button class="filter-btn tipo-procedimiento" id="f-procedimiento" role="radio" aria-checked="false"
            data-value="procedimiento">Procedimiento</button>
          <button class="filter-btn tipo-urgencia" id="f-urgencia" role="radio" aria-checked="false"
            data-value="urgencia">Urgencia</button>
        </div>

      </div>

      <!-- Tabla de citas con estructura accesible -->
      <div class="table-card">
        <div class="table-scroll">
          <table class="agenda-table" aria-label="Agenda de citas que requieren asistencia">
            <thead>
              <tr>
                <th scope="col">HORA</th>
                <th scope="col">PACIENTE</th>
                <th scope="col">PROFESIONAL</th>
                <th scope="col">TIPO</th>
                <th scope="col">ALERGIAS</th>
                <th scope="col">ESTADO</th>
              </tr>
            </thead>
            <tbody id="agendaBody" aria-live="polite">
              <!-- Las filas se generan dinámicamente por JavaScript -->
            </tbody>
          </table>
        </div>
        <div class="table-empty" id="tableEmpty" style="display:none" role="status" aria-live="polite">
          No hay citas que coincidan con el filtro seleccionado.
        </div>
      </div>

    </div>

  </main>

  <!-- Mobile bottom nav con aria-label para navegación móvil -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-aux-01-panel-operativo/panel-operativo" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📊</span>
      <span>Panel</span>
    </a>
    <a href="#" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon" aria-hidden="true">📅</span>
      <span>Agenda</span>
    </a>
    <a href="/gestion-de-citas/st-aux-05-historial-parcial" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📋</span>
      <span>Historial</span>
    </a>
  </nav>

  <!-- Toast con aria-atomic para anuncio completo de notificaciones -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para contenido solo accesible por screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;">🦷</span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.nav-group-header').forEach(header => {
      const items = header.nextElementSibling;
      const arrow = header.querySelector('.nav-arrow');

      if (!items || !arrow) return;

      const setExpanded = (isExpanded) => {
        items.style.maxHeight = isExpanded ? `${items.scrollHeight}px` : '0px';
        arrow.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
        header.setAttribute('aria-expanded', String(isExpanded));
      };

      setExpanded(false);

      const toggle = () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        setExpanded(!isExpanded);
      };

      header.addEventListener('click', toggle);
      header.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  });
</script>
  <script src="@Url.Content("~/js/Gestion_De_Citas/st-aux-02-agenda-apoyo/agenda-apoyo.js")"></script>

</body>

</html>

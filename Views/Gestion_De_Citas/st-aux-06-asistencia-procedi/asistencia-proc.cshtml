        <h1 class="page-title">Asistencia en Procedimiento</h1>
        <p class="page-subtitle">Endodoncia pieza 23 · Dr. Andrés Torres · Consultorio 3</p>
      </div>
    </header>

    <!-- Alerta médica con role alert para anuncio inmediato -->
    <div class="alert-banner" role="alert" aria-live="assertive">
      <span class="alert-banner-icon" aria-hidden="true">⚠️</span>
      <p class="alert-banner-text"><strong>ALERTA</strong> — Pedro García · Alérgico a Penicilina · Enalapril 5mg</p>
    </div>

    <!-- Layout de contenido -->
    <div class="content-layout">

      <!-- Columna izquierda: Timer + Datos -->
      <div class="content-left">

        <!-- Tarjeta de estado con timer accesible -->
        <div class="status-card">
          <div class="timer-circle" role="timer" aria-label="Tiempo transcurrido del procedimiento" aria-live="polite">
            <span class="timer-value" id="timerValue">24</span>
            <span class="timer-label">min</span>
          </div>
          <div class="status-info">
            <p class="status-label">Estado del procedimiento</p>
            <span class="status-badge" role="status">En curso</span>
            <p class="status-time">Iniciado a las <time datetime="2026-03-20T10:03">10:03 AM</time></p>
          </div>
        </div>

        <!-- Datos de la cita -->
        <div class="data-card">
          <h3 class="data-card-title">Datos de la cita</h3>
          <div class="data-row"><strong>Paciente:</strong> <span>Pedro García</span></div>
          <div class="data-row"><strong>Profesional:</strong> <span>Dr. Andrés Torres</span></div>
          <div class="data-row"><strong>Servicio:</strong> <span>Endodoncia pieza 23</span></div>
          <div class="data-row"><strong>Consultorio:</strong> <span>Consultorio 3 - piso 2</span></div>
        </div>

      </div>

      <!-- Columna derecha: Alertas + Estado del procedimiento -->
      <aside class="content-right">

        <!-- Alertas del paciente con role list -->
        <div class="alert-card">
          <p class="alert-card-title">🔔 Alertas del paciente</p>
          <div class="alert-item" role="listitem">
            <span class="alert-icon" aria-hidden="true">🚨</span>
            <span><strong>Alergia:</strong> Penicilina</span>
          </div>
          <div class="alert-item" role="listitem">
            <span class="alert-icon" aria-hidden="true">💊</span>
            <span><strong>Medicamentos:</strong> Enalapril 5mg</span>
          </div>
          <div class="alert-item" role="listitem">
            <span class="alert-icon" aria-hidden="true">📋</span>
            <span><strong>Antecedentes:</strong> Hipertensión leve</span>
          </div>
          <div class="alert-item" role="listitem">
            <span class="alert-icon" aria-hidden="true">🩸</span>
            <span><strong>Grupo sanguíneo:</strong> O+</span>
          </div>
        </div>

        <!-- Estado del procedimiento con píldoras interactivas -->
        <div class="procedure-card">
          <h3 class="procedure-card-title">Estado del Procedimiento</h3>

          <div class="procedure-row">
            <span class="procedure-label">
              <span class="procedure-icon" aria-hidden="true">🧹</span>
              Limpieza
            </span>
            <button class="procedure-pill azul" id="pillLimpieza" aria-pressed="false"
              aria-label="Marcar limpieza como completada">Limpieza</button>
          </div>

          <div class="procedure-row">
            <span class="procedure-label">
              <span class="procedure-icon" aria-hidden="true">🔬</span>
              Esterilización
            </span>
            <button class="procedure-pill verde" id="pillEsterilizacion" aria-pressed="false"
              aria-label="Marcar esterilización como completada">Esterilización</button>
          </div>

          <div class="procedure-row">
            <span class="procedure-label">
              <span class="procedure-icon" aria-hidden="true">⚙️</span>
              Equipos
            </span>
            <button class="procedure-pill gris" id="pillEquipos" aria-pressed="false"
              aria-label="Marcar equipos como completada">Equipos</button>
          </div>

        </div>


@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Dashboard General administrativo de SmileTrack - Sistema de Gestión de Citas Odontológicas. Indicadores, pacientes y citas." />
  <title>SmileTrack Dashboard General</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_Citas/st-adm-01-dashboard/styles.css")" />
</head>

<body>

  <!-- Enlace para saltar al contenido principal (accesibilidad) -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

 <aside class="sidebar" id="sidebar" aria-label="Navegación principal">
  <div class="sidebar-logo">
    <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="SmileTrack" class="logo-img" />
  </div>
  @{ await Html.RenderPartialAsync("_SidebarAdmin"); }
              <div class="sidebar-user">
      <div class="user-avatar" aria-hidden="true">@(User.Identity?.Name?.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpperInvariant() : (User.Identity?.Name?.ToUpperInvariant() ?? "U"))</div>
      <div class="user-info">
        <span class="user-role">@User.Identity?.Name</span>
        <span class="user-email">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
      </div>
    </div>
</aside>



  <!--  HAMBURGER (móvil)  -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!--  MAIN  -->
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Administración</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Dashboard</span>
        </nav>
        <h1 class="page-title">Dashboard General</h1>
       <p class="page-subtitle">
  Resumen en tiempo real ·
  <time datetime="@DateTime.Now.ToString("yyyy-MM-dd")" id="headerDate">@DateTime.Now.ToString("dddd d 'de' MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</time>
</p>
      </div>
      <div style="display: flex; gap: 12px; align-items: center;">
        <button class="btn-primary" id="btnExport" aria-label="Exportar reporte PDF" title="Generar reporte en formato PDF">
          📄 Exportar PDF
        </button>
        <a class="btn-primary" href="/gestion-de-citas/st-adm-09-citas?action=new" aria-label="Programar nueva cita">
          + Nueva Cita
        </a>
      </div>
    </header>

    <!-- Barra de progreso superior -->
    <div class="progress-row" role="progressbar" aria-valuenow="@(ViewData["PctOcupacion"] is int po ? po : 0)" aria-valuemin="0" aria-valuemax="100"
      aria-label="Ocupación de la agenda: @(ViewData["PctOcupacion"] is int ppo ? ppo : 0)%">
      <div class="progress-bar-wrap">
        <div class="progress-bar" id="topProgressBar" style="width:@(ViewData["PctOcupacion"] is int poWidth ? poWidth : 0)%"></div>
      </div>
      <span class="progress-label" aria-live="polite">Ocupación de agenda (@(ViewData["PctOcupacion"] is int ppo2 ? ppo2 : 0)%)</span>
    </div>

    <!-- Stats Grid -->
    <section class="stats-grid" aria-label="Métricas principales">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="statPacientes" data-target="@ViewData["TotalPacientes"]" aria-live="polite">0</span>
        <span class="stat-label">Pacientes activos</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="statCitas" data-target="@ViewData["CitasHoy"]" aria-live="polite">0</span>
        <span class="stat-label">Citas hoy</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number" id="statProfesionales" data-target="@ViewData["ProfesionalesActivos"]" aria-live="polite">0</span>
        <span class="stat-label">Profesionales activos</span>
      </div>
      <div class="stat-card" data-color="purple">
        <span class="stat-number" id="statIngresos" aria-live="polite">$@((ViewData["IngresosDelMes"] is decimal ing ? ing : 0m).ToString("N0"))</span>
        <span class="stat-label">Ingresos del mes</span>
        <span class="stat-vs" style="visibility:hidden" aria-hidden="true">— módulo en desarrollo</span>
      </div>
    </section>

    <!-- Content Grid -->
    <div class="content-grid">

      <!-- Columna izquierda: Gráficos -->
      <div class="content-left">

        <!-- Gráfico de ingresos -->
        <section class="card" aria-labelledby="revenueTitle">
          <h2 class="card-title" id="revenueTitle">Ingresos por mes</h2>
          <p class="chart-summary">Este panel se activará cuando el módulo de Facturación esté implementado.</p>
        </section>

        <!-- Tabla de profesionales top -->
        <section class="card" aria-labelledby="topProfTitle">
          <h2 class="card-title" id="topProfTitle">Top profesionales del mes</h2>
          <div class="table-wrap">
            <table class="table-base" aria-label="Tabla de profesionales mÃ¡s productivos">
              <thead>
                <tr>
                  <th scope="col">Profesional</th>
                  <th scope="col" style="text-align:center">Espec.</th>
                  <th scope="col" style="text-align:center">Citas</th>
                </tr>
              </thead>
              <tbody>
                @{ var topProfesionales = ViewData["TopProfesionales"] as IEnumerable<dynamic>; }
                @if (topProfesionales != null && topProfesionales.Any())
                {
                  foreach (var prof in topProfesionales)
                  {
                    <tr>
                      <td><span class="td-name">@prof.Nombre</span></td>
                      <td style="text-align:center"><span class="badge-spec">@prof.Especialidad</span></td>
                      <td style="text-align:center" class="td-strong">@prof.TotalCitas</td>
                    </tr>
                  }
                }
                else
                {
                  <tr><td colspan="3">Sin citas registradas este mes.</td></tr>
                }
              </tbody>
            </table>
          </div>
        </section>

      </div>

      <!-- Columna derecha: Estado e invoices -->
      <div class="content-right">

        <!-- Estado de citas -->
        <section class="card" aria-labelledby="statusTitle">
          <h2 class="card-title" id="statusTitle">Citas del mes por estado</h2>
          <div class="status-chart" id="statusChart" role="img" aria-label="GrÃ¡fico de estado de citas">
            <div class="status-row">
              <span class="status-label">Atendidas</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill green" data-width="@ViewData["PctAtendidas"]" style="width:0" role="progressbar" aria-valuenow="@ViewData["PctAtendidas"]" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <span class="status-val">@ViewData["CitasAtendidas"]</span>
            </div>
            <div class="status-row">
              <span class="status-label">Confirmadas</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill blue" data-width="@ViewData["PctConfirmadas"]" style="width:0" role="progressbar" aria-valuenow="@ViewData["PctConfirmadas"]" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <span class="status-val">@ViewData["CitasConfirmadas"]</span>
            </div>
            <div class="status-row">
              <span class="status-label">Programadas</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill orange" data-width="@ViewData["PctProgramadas"]" style="width:0" role="progressbar" aria-valuenow="@ViewData["PctProgramadas"]" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <span class="status-val">@ViewData["CitasProgramadas"]</span>
            </div>
            <div class="status-row">
              <span class="status-label">Canceladas</span>
              <div class="status-bar-bg">
                <div class="status-bar-fill red" data-width="@ViewData["PctCanceladas"]" style="width:0" role="progressbar" aria-valuenow="@ViewData["PctCanceladas"]" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <span class="status-val">@ViewData["CitasCanceladas"]</span>
            </div>
          </div>
        </section>

        <!-- Facturas pendientes -->
        <section class="card" aria-labelledby="invoicesTitle">
          <h2 class="card-title" id="invoicesTitle">Facturas pendientes de cobro</h2>
          <div class="invoices-list" role="list">
            <p class="chart-summary">Disponible cuando el módulo de Facturación esté implementado.</p>
          </div>
          <div class="invoices-total" aria-live="polite">
            <span>Total pendiente:</span>
            <strong>$0</strong>
          </div>
        </section>

      </div>

    </div>

  </main>

  <!-- Mobile bottom nav -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="#" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon" aria-hidden="true"></span>
      <span>Inicio</span>
    </a>
    <a href="/gestion-de-citas/st-adm-01-dashboard" class="mobile-nav-item active">
      <span class="mobile-nav-icon" aria-hidden="true"></span>
      <span>Dashboard</span>
    </a>
    <a href="/gestion-de-citas/st-adm-08-agenda" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true"></span>
      <span>Agenda</span>
    </a>
    <a href="/gestion-de-citas/st-adm-09-citas" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true"></span>
      <span>Citas</span>
    </a>
  </nav>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;"></span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>


  <script>
    window.APP_CONFIG = {
      ApiBase: '/api' // Aquí podrías inyectar @Url.Content("~/api") si la URL cambia
    };
  </script>
  <script src="@Url.Content("~/js/Gestion_De_Citas/st-adm-01-dashboard/app.js")"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.nav-group-header').forEach(header => {
      const items = header.nextElementSibling;
      const arrow = header.querySelector('.nav-arrow');

      if (!items || !arrow) return;

      const setExpanded = (isExpanded) => {
        items.style.maxHeight = isExpanded ? `${items.scrollHeight}px` : '0px';
        arrow.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
        header.setAttribute('aria-expanded', String(isExpanded));
      };

      setExpanded(false);

      const toggle = () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        setExpanded(!isExpanded);
      };

      header.addEventListener('click', toggle);
      header.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  });
</script>
</body>

</html>



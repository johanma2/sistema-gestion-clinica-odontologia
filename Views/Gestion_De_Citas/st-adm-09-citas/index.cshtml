@{ Layout = null;
  var pacientes = ViewData["Pacientes"] as List<SmileTrack_MVC.Models.Entities.Paciente> ?? new();
  var profesionales = ViewData["Profesionales"] as List<SmileTrack_MVC.Models.Entities.Profesional> ?? new();
  var servicios = ViewData["Servicios"] as List<SmileTrack_MVC.Models.Entities.Servicio> ?? new();
  var citas = ViewData["Citas"] as List<SmileTrack_MVC.Models.Entities.Cita> ?? new();
  var profesionalesFilterOptions = ViewData["ProfesionalesFilterOptions"] as List<SmileTrack_MVC.Models.Entities.Profesional> ?? new();
  var pageResult = ViewData["CitasPage"] as SmileTrack_MVC.Models.Shared.PagedResult<SmileTrack_MVC.Models.Entities.Cita>;
}

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Gestiona y supervisa el historial completo de citas en SmileTrack." />
  <title>SmileTrack — Gestión de Citas</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
  <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_Citas/st-adm-09-citas/gestionintegral.css")" />
</head>

<body>

  <!-- Enlace para saltar al contenido principal (accesibilidad) -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <aside class="sidebar" id="sidebar" aria-label="Navegación principal">
    <div class="sidebar-logo">
      <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="SmileTrack" class="logo-img" />
    </div>
    @{ await Html.RenderPartialAsync("_SidebarAdmin"); }
      <div class="sidebar-user">
      <div class="user-avatar" aria-hidden="true">@(User.Identity?.Name?.Substring(0, 2).ToUpperInvariant() ?? "U")</div>
      <div class="user-info">
        <span class="user-role">@User.Identity?.Name</span>
        <span class="user-email">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
      </div>
    </div>
  </aside>



  <!--  HAMBURGER (m�vil) -->
  <button class="hamburger" id="hamburger" aria-label="Abrir men�" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- MAIN -->
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegaci�n">
          <span>Administración</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Gestión de Citas</span>
        </nav>
        <h1 class="page-title">Gestión Integral de Citas</h1>
        <p class="page-subtitle">Supervisión y control</p>
      </div>

    </header>

    <!-- KPI Cards con aria-live para contadores -->
    <section class="stats-grid" aria-label="Resumen de citas">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="statTotal" data-target="284" aria-live="polite">0</span>
        <span class="stat-label">Total Citas</span>
        <span class="stat-sub">Este mes</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="statScheduled" data-target="48" aria-live="polite">0</span>
        <span class="stat-label">Programadas</span>
        <span class="stat-sub">? +12 vs semana pasada</span>
      </div>
      <div class="stat-card" data-color="red">
        <span class="stat-number" id="statCancelled" data-target="12" aria-live="polite">0</span>
        <span class="stat-label">Canceladas</span>
        <span class="stat-sub">Tasa: 4.2%</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number" id="statAttended" data-target="224" aria-live="polite">0</span>
        <span class="stat-label">Atendidas</span>
        <span class="stat-sub">? 79% asistencia</span>
      </div>
    </section>

    <!-- El formulario en l�nea fue removido y convertido en Modal -->

    <section class="table-section" aria-labelledby="tableTitle">
      <h2 class="visually-hidden" id="tableTitle">Lista de citas</h2>

      <!-- Tabs accesibles -->
      <div class="table-tabs" role="tablist" aria-label="Filtrar citas por estado">
        <button class="tab-btn active" data-tab="all" role="tab" aria-selected="true" aria-controls="citasBody">Todas
          las citas</button>
        <button class="tab-btn" data-tab="cancelled" role="tab" aria-selected="false"
          aria-controls="citasBody">Cancelaciones</button>
        <button class="tab-btn" data-tab="no-show" role="tab" aria-selected="false" aria-controls="citasBody">No
          asisti�</button>
      </div>

      <!-- Filtros -->
      <section class="filters-section" aria-label="Filtros de búsqueda">
        <form method="get" class="filters-row">
          <div class="search-wrap">
            <span class="search-icon" aria-hidden="true">🔍</span>
            <input type="search" id="searchAppointments" name="search" class="search-input" placeholder="Buscar paciente..."
              aria-label="Buscar paciente" value="@ViewData["SearchFilter"]">
          </div>
          <div class="filter-wrap">
            <select id="filterStatus" name="estado" class="status-select" aria-label="Filtrar por estado">
              <option value="">Todos los estados</option>
              @if (ViewData["EstadoFilter"]?.ToString() == "programada")
              {
                <option value="programada" selected>Programada</option>
              }
              else
              {
                <option value="programada">Programada</option>
              }
              @if (ViewData["EstadoFilter"]?.ToString() == "confirmada")
              {
                <option value="confirmada" selected>Confirmada</option>
              }
              else
              {
                <option value="confirmada">Confirmada</option>
              }
              @if (ViewData["EstadoFilter"]?.ToString() == "atendida")
              {
                <option value="atendida" selected>Atendida</option>
              }
              else
              {
                <option value="atendida">Atendida</option>
              }
              @if (ViewData["EstadoFilter"]?.ToString() == "cancelada")
              {
                <option value="cancelada" selected>Cancelada</option>
              }
              else
              {
                <option value="cancelada">Cancelada</option>
              }
            </select>
          </div>
          <div class="filter-wrap">
            <select id="filterProfessional" name="profesional" class="status-select" aria-label="Filtrar por profesional">
              <option value="">Cualquier profesional</option>
              @foreach (var profesional in profesionalesFilterOptions)
              {
                if (ViewData["ProfesionalFilter"]?.ToString() == profesional.IdProfesional.ToString())
                {
                  <option value="@profesional.IdProfesional" selected>@profesional.NombreProfesional</option>
                }
                else
                {
                  <option value="@profesional.IdProfesional">@profesional.NombreProfesional</option>
                }
              }
            </select>
          </div>
          <div class="filter-wrap">
            <input type="date" id="filterDate" name="fecha" class="filter-date" aria-label="Filtrar por fecha" value="@ViewData["FechaFilter"]">
          </div>
          <input type="hidden" name="page" value="1" />
          <button class="btn-primary" type="submit">Aplicar</button>
          <a class="btn-secondary" href="@Url.Action("Stadm09Citas", "GestionCitas")">🗑️ Limpiar</a>
        </form>
      </section>

      <!-- Cabecera de tabla accesible -->
      <div class="table-header" role="row">
        <div class="table-col col-fecha" role="columnheader">Fecha</div>
        <div class="table-col col-hora" role="columnheader">Hora</div>
        <div class="table-col col-paciente" role="columnheader">Paciente</div>
        <div class="table-col col-profesional" role="columnheader">Profesional</div>
        <div class="table-col col-servicio" role="columnheader">Servicio</div>
        <div class="table-col col-estado text-center" role="columnheader">Estado</div>
        <div class="table-col col-acciones text-right" role="columnheader">Acciones</div>
      </div>

      <!-- Cuerpo de tabla con aria-live -->
      <div id="citasBody" class="table-body" role="rowgroup" aria-live="polite">
        @foreach (var cita in citas)
        {
          <div class="table-row" role="row">
            <div class="table-col col-fecha" role="cell">@cita.Fecha.ToString("dd/MM/yyyy")</div>
            <div class="table-col col-hora" role="cell">@(cita.HoraInicio?.ToString("hh\\:mm") ?? "—")</div>
          @{
            var pacNombre = cita.Paciente?.NombresCompleto ?? "?";
            var pacInitials = string.Concat(pacNombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant();
            var pacColors = new[] { "#2563eb", "#059669", "#d97706", "#7c3aed", "#db2777" };
            var pacColor = pacColors[Math.Abs(pacNombre.GetHashCode()) % pacColors.Length];
            var profNombre = cita.Profesional?.NombreProfesional ?? string.Empty;
            var profInitials = string.IsNullOrEmpty(profNombre) ? "—" : string.Concat(profNombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant();
            var profColor = string.IsNullOrEmpty(profNombre) ? "#94a3b8" : pacColors[Math.Abs(profNombre.GetHashCode()) % pacColors.Length];
            var especialidadPrincipal = cita.Profesional?.Especialidades?.FirstOrDefault(pe => pe.Principal)?.Especialidad?.Nombre ?? cita.Profesional?.Especialidades?.FirstOrDefault()?.Especialidad?.Nombre ?? "General";
          }
            <div class="table-col col-paciente" role="cell">
              <div class="patient-info">
                <div class="patient-avatar" style="background:@pacColor;">@pacInitials</div>
                <div><span class="patient-name">@pacNombre</span></div>
              </div>
            </div>
            <div class="table-col col-profesional" role="cell">
              <div class="patient-info">
                <div class="patient-avatar" style="background:@profColor; opacity:@(string.IsNullOrEmpty(profNombre) ? "0.4" : "1");">@profInitials</div>
                <div style="display:flex; flex-direction:column; align-items:flex-start;">
                  <span class="patient-name">@(string.IsNullOrEmpty(profNombre) ? "Sin asignar" : profNombre)</span>
                  @if (!string.IsNullOrEmpty(profNombre)) {
                    <span class="badge-spec @((especialidadPrincipal).ToLowerInvariant())" style="font-size: 0.65rem; padding: 2px 6px; margin-top: 2px;">@especialidadPrincipal</span>
                  }
                </div>
              </div>
            </div>
            <div class="table-col col-servicio" role="cell">@cita.MotivoConsulta</div>
            <div class="table-col col-estado text-center" role="cell">
              <form method="post" action="/gestion-de-citas/guardar-cita" class="form-estado-inline" style="display:inline-block; margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdCita" value="@cita.IdCita" />
                <input type="hidden" name="IdPaciente" value="@cita.IdPaciente" />
                <input type="hidden" name="FechaHora" value="@cita.FechaHora.ToString("yyyy-MM-ddTHH:mm:ss")" />
                <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                <select name="Estado" class="status-badge status-select-inline @((cita.Estado ?? string.Empty).ToLowerInvariant())" onchange="this.form.submit()" aria-label="Cambiar estado de la cita">
                  @foreach (var estado in new[] { "Programada", "Confirmada", "Atendida", "Cancelada" })
                  {
                    if (string.Equals(cita.Estado, estado, StringComparison.OrdinalIgnoreCase))
                    {
                      <option value="@estado.ToLower()" selected>@estado</option>
                    }
                    else
                    {
                      <option value="@estado.ToLower()">@estado</option>
                    }
                  }
                </select>
              </form>
            </div>
            <div class="table-col col-acciones text-right" role="cell">
              <a class="action-btn" href="@Url.Action("Stadm09Citas", "GestionCitas", new { editId = cita.IdCita })" title="Editar">✏️ <span class="btn-text">Editar</span></a>
              <form method="post" action="/gestion-de-citas/eliminar-cita" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdCita" value="@cita.IdCita" />
                <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                <button class="action-btn btn-delete" type="submit" onclick="return confirm('¿Eliminar esta cita?');" title="Eliminar">❌ <span class="btn-text">Eliminar</span></button>
              </form>
            </div>
          </div>
        }
      </div>

      <!-- Paginación accesible -->
      <footer class="table-footer" aria-label="Navegación de páginas">
        @{ }
        <span>Mostrando <strong id="pageShowing">@Math.Min(pageResult?.PageSize ?? 10, pageResult?.Items.Count ?? 0)</strong> de <strong id="pageTotal">@pageResult?.TotalCount</strong> citas</span>
        <nav class="pagination" aria-label="Páginas de resultados">
          @if (pageResult != null && pageResult.HasPreviousPage)
          {
            <a class="pagination-btn" aria-label="Página anterior" href="@Url.Action("Stadm09Citas", "GestionCitas", new { page = pageResult.Page - 1, pageSize = pageResult.PageSize, search = ViewData["SearchFilter"], estado = ViewData["EstadoFilter"], profesional = ViewData["ProfesionalFilter"], fecha = ViewData["FechaFilter"] })">‹</a>
          }
          else
          {
            <button class="pagination-btn" aria-label="Página anterior" disabled>‹</button>
          }
          @for (var i = 1; i <= (pageResult?.TotalPages ?? 1); i++)
          {
            var isActive = i == (pageResult?.Page ?? 1);
            <a class="pagination-btn @(isActive ? "active" : string.Empty)" aria-current="@(isActive ? "page" : null)" aria-label="Página @i" href="@Url.Action("Stadm09Citas", "GestionCitas", new { page = i, pageSize = pageResult?.PageSize ?? 10, search = ViewData["SearchFilter"], estado = ViewData["EstadoFilter"], profesional = ViewData["ProfesionalFilter"], fecha = ViewData["FechaFilter"] })">@i</a>
          }
          @if (pageResult != null && pageResult.HasNextPage)
          {
            <a class="pagination-btn" aria-label="Página siguiente" href="@Url.Action("Stadm09Citas", "GestionCitas", new { page = pageResult.Page + 1, pageSize = pageResult.PageSize, search = ViewData["SearchFilter"], estado = ViewData["EstadoFilter"], profesional = ViewData["ProfesionalFilter"], fecha = ViewData["FechaFilter"] })">›</a>
          }
          else
          {
            <button class="pagination-btn" aria-label="Página siguiente" disabled>›</button>
          }
        </nav>
      </footer>
    </section>

    <!-- Banner con datos reales del controller -->
    <section class="info-banner" role="complementary" aria-label="Resumen de disponibilidad">
      <div class="banner-content">
        <h3 class="banner-title">Resumen de Citas del Mes</h3>
        <p class="banner-text">
          @{
            var totalCitas = citas.Count;
            var atendidas = citas.Count(c => string.Equals(c.EstadoCita?.NombreEstado, "Atendida", StringComparison.OrdinalIgnoreCase));
            var canceladas = citas.Count(c => string.Equals(c.EstadoCita?.NombreEstado, "Cancelada", StringComparison.OrdinalIgnoreCase));
            var programadas = citas.Count(c => string.Equals(c.EstadoCita?.NombreEstado, "Agendada", StringComparison.OrdinalIgnoreCase));
          }
          Total en vista: <strong>@totalCitas</strong> citas —
          <span style="color:#22c55e">✅ @atendidas atendidas</span> —
          <span style="color:#f59e0b">📅 @programadas programadas</span> —
          <span style="color:#ef4444">❌ @canceladas canceladas</span>
        </p>
      </div>
    </section>

  </main>

  <!-- Modal: Detalle de Cita -->
  <div class="modal-overlay" id="modalAppointment" role="dialog" aria-modal="true"
    aria-labelledby="modalAppointmentTitle" aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalAppointmentClose" aria-label="Cerrar ventana">×</button>
      <h2 class="modal-title" id="modalAppointmentTitle">Detalle de Cita</h2>
      <div id="modalAppointmentContent" class="modal-content" role="document"></div>
      <div class="modal-footer">
        <button class="btn-secondary" id="modalAppointmentCancel">Cerrar</button>
        <button class="btn-primary" id="modalAppointmentEdit">Editar</button>
      </div>
    </div>
  </div>

  <!-- Mobile bottom nav -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-adm-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📊</span>
      <span>Dashboard</span>
    </a>
    <a href="#" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon" aria-hidden="true">🗓️</span>
      <span>Citas</span>
    </a>
    <a href="/gestion-de-citas/st-adm-08-agenda" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📅</span>
      <span>Agenda</span>
    </a>
  </nav>

  <!-- Toast para notificaciones accesibles -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* Modal Styles */
    .modal-overlay {
      position: fixed !important;
      top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important;
      background: rgba(15, 32, 87, 0.55);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 99999;
    }
    .modal-overlay.open { display: flex !important; }
    .modal {
      background: #fff;
      border-radius: 14px;
      padding: 24px 22px;
      width: 95%;
      max-width: 500px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 20px 60px rgba(0,0,0,.35);
      position: relative;
      margin: auto;
      animation: fadeInModal .2s ease;
    }
    @@keyframes fadeInModal { from { opacity: 0; transform: translateY(-16px); } to { opacity: 1; transform: none; } }
    /* Avatar en tabla de citas */
    .patient-info { display: flex; align-items: center; gap: 10px; }
    .patient-avatar {
      width: 40px; height: 40px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: .75rem; color: #fff;
      flex-shrink: 0;
    }
    .patient-name { font-weight: 600; color: var(--text); font-size: .85rem; }
    .modal-title { font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; color: var(--primary); margin-bottom: 20px; }
    .modal-close { position: absolute; top: 16px; right: 16px; background: none; border: none; font-size: 1.5rem; color: var(--text-muted); cursor: pointer; transition: color 0.2s; }
    .modal-close:hover { color: var(--danger); }
    .form-group { margin-bottom: 16px; }
    .form-label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--text); margin-bottom: 6px; }
    .form-input { width: 100%; border: 1.5px solid var(--border); border-radius: var(--radius-sm); padding: 10px 12px; font-family: var(--font); font-size: 0.85rem; transition: border-color 0.2s; }
    .form-input:focus { border-color: var(--primary); outline: none; }
    .modal-footer { display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border); }
    
    /* Inline Status Select (Badge) */
    select.status-select-inline {
      appearance: none;
      -webkit-appearance: none;
      background-color: transparent;
      border: none;
      color: inherit;
      font-family: inherit;
      font-size: inherit;
      font-weight: inherit;
      padding: 0;
      margin: 0;
      cursor: pointer;
      text-align: center;
      text-transform: capitalize;
    }
    select.status-select-inline:focus {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
      border-radius: 4px;
    }
    select.status-select-inline option {
      background-color: #fff;
      color: #333;
    }
  </style>

  <!-- Modal: Crear/Editar Cita -->
  <div class="modal-overlay" id="modalCita" role="dialog" aria-modal="true" aria-labelledby="modalCitaTitle" aria-hidden="true">
    <div class="modal">
      <button class="modal-close" onclick="document.getElementById('modalCita').classList.remove('open');" aria-label="Cerrar ventana">×</button>
      <h2 class="modal-title" id="modalCitaTitle">@(ViewData["EditingCita"] != null ? "Editar Cita" : "Nueva Cita")</h2>
      <form method="post" action="/gestion-de-citas/guardar-cita">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
        <input type="hidden" name="IdCita" value="@(((SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"])?.IdCita ?? 0)" />
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px;">
          <div class="form-group">
            <label class="form-label">Paciente *</label>
            <select name="IdPaciente" class="form-input" required>
              <option value="">Seleccione paciente</option>
              @foreach (var paciente in pacientes)
              {
                var editingCita = (SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"];
                var selected = editingCita?.IdPaciente == paciente.IdPaciente ? "selected" : "";
                <option value="@paciente.IdPaciente" selected="@(selected)">@paciente.NombresCompleto</option>
              }
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Profesional</label>
            <select name="IdProfesional" class="form-input">
              <option value="">Seleccione profesional</option>
              @foreach (var profesional in profesionales)
              {
                var editingCita = (SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"];
                var selected = editingCita?.IdProfesional == profesional.IdProfesional ? "selected" : "";
                <option value="@profesional.IdProfesional" selected="@(selected)">@profesional.NombreProfesional</option>
              }
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Servicio</label>
            <select name="IdConsultorio" class="form-input">
              <option value="">Seleccione consultorio</option>
              @foreach (var consultorio in (ViewData["Consultorios"] as List<SmileTrack_MVC.Models.Entities.Consultorio> ?? new()))
              {
                var editingCita = (SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"];
                var selected = editingCita?.IdConsultorio == consultorio.IdConsultorio ? "selected" : "";
                <option value="@consultorio.IdConsultorio" selected="@(selected)">@consultorio.Nombre</option>
              }
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Fecha *</label>
            <input type="date" name="Fecha" class="form-input" value="@(((SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"])?.Fecha.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" required />
          </div>

          <div class="form-group" style="grid-column: 1 / -1;">
            <label class="form-label">Hora Inicio</label>
            <input type="time" name="HoraInicio" class="form-input" value="@(((SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"])?.HoraInicio?.ToString("hh\\:mm") ?? "09:00")" />

            <label class="form-label">Hora Fin</label>
            <input type="time" name="HoraFin" class="form-input" value="@(((SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"])?.HoraFin?.ToString("hh\\:mm") ?? "09:30")" />

            <label class="form-label">Estado *</label>
            <select name="IdEstado" class="form-input">
              @{ var editingCitaEstado = (SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"]; }
              @foreach (var estado in (ViewData["EstadosCita"] as List<SmileTrack_MVC.Models.Entities.EstadoCita> ?? new()))
              {
                var selected = editingCitaEstado?.IdEstado == estado.IdEstado ? "selected" : "";
                <option value="@estado.IdEstado" selected="@(selected)">@estado.NombreEstado</option>
              }
            </select>
          </div>

          <div class="form-group" style="grid-column: 1 / -1;">
            <label class="form-label">Motivo consulta</label>
            <textarea name="MotivoConsulta" class="form-input" rows="2" placeholder="Motivo principal de la cita...">@(((SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"])?.MotivoConsulta)</textarea>

            <label class="form-label">Notas previas</label>
            <textarea name="NotasPrevias" class="form-input" rows="2" placeholder="Observaciones de la cita...">@(((SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"])?.NotasPrevias)</textarea>

            <label class="form-label">Tipo de cita</label>
            <input type="text" name="TipoCita" class="form-input" value="@(((SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"])?.TipoCita ?? "Consulta")" />
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-secondary" onclick="document.getElementById('modalCita').classList.remove('open');">Cancelar</button>
          <button type="submit" class="btn-primary">@(ViewData["EditingCita"] != null ? "Guardar cambios" : "Crear cita")</button>
        </div>
      </form>
    </div>
  </div>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;">🦷</span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>


  <script src="@Url.Content("~/js/site.js")" defer></script>
  <script src="@Url.Content("~/js/Gestion_De_Citas/st-adm-09-citas/gestionintegral.js")"></script>

  <script>
  document.addEventListener('DOMContentLoaded', () => {
    // Filtros se auto-envian al cambiar select 
    const filterForm = document.querySelector('form[method="get"]');
    if (filterForm) {
      filterForm.querySelectorAll('select').forEach(sel => {
        sel.addEventListener('change', () => filterForm.submit());
      });
    }

    // Tabs filtran la tabla por estado
    const tabBtns = document.querySelectorAll('.tab-btn');
    const rows = document.querySelectorAll('#citasBody .table-row');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const tab = btn.dataset.tab;
        rows.forEach(row => {
          const badge = row.querySelector('.status-badge');
          const estado = badge ? badge.textContent.trim().toLowerCase() : '';
          if (tab === 'all') {
            row.style.display = '';
          } else if (tab === 'cancelled') {
            row.style.display = estado === 'cancelada' ? '' : 'none';
          } else if (tab === 'no-show') {
            row.style.display = estado === 'no asistió' || estado === 'inasistencia' ? '' : 'none';
          }
        });
      });
    });

    // Auto-abrir modal de cita si estamos en edición
    const isEditingCita = '@(ViewData["EditingCita"] != null ? "true" : "false")' === 'true';
    if (isEditingCita) {
      document.getElementById('modalCita').classList.add('open');
    }
  });
  </script>
</body>

</html>



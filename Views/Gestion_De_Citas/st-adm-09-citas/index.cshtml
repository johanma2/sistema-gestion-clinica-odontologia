@{ Layout = null;
  var pacientes = ViewData["Pacientes"] as List<SmileTrack_MVC.Models.Entities.Paciente> ?? new();
  var profesionales = ViewData["Profesionales"] as List<SmileTrack_MVC.Models.Entities.Profesional> ?? new();
  var servicios = ViewData["Servicios"] as List<SmileTrack_MVC.Models.Entities.Servicio> ?? new();
  var citas = ViewData["Citas"] as List<SmileTrack_MVC.Models.Entities.Cita> ?? new();
  var profesionalesFilterOptions = ViewData["ProfesionalesFilterOptions"] as List<SmileTrack_MVC.Models.Entities.Profesional> ?? new();
  var pageResult = ViewData["CitasPage"] as SmileTrack_MVC.Models.Shared.PagedResult<SmileTrack_MVC.Models.Entities.Cita>;
}

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Gestiona y supervisa el historial completo de citas en SmileTrack." />
  <title>SmileTrack — Gestión de Citas</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_Citas/st-adm-09-citas/gestionintegral.css")" />
</head>

<body>

  <!-- Enlace para saltar al contenido principal (accesibilidad) -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <aside class="sidebar" id="sidebar" aria-label="Navegación principal">
    <div class="sidebar-logo">
      <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="SmileTrack" class="logo-img" />
    </div>
    @{ await Html.RenderPartialAsync("_SidebarAdmin"); }
    <div class="sidebar-user">
      <div class="user-avatar" aria-hidden="true">AD</div>
      <div class="user-info">
        <span class="user-role">Administrador</span>
        <span class="user-email">admin@smiletrack.co</span>
      </div>
    </div>
  </aside>



  <!-- ═════ HAMBURGER (móvil) ═════ -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Administración</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Gestión de Citas</span>
        </nav>
        <h1 class="page-title">Gestión Integral de Citas</h1>
        <p class="page-subtitle">Supervisión y control</p>
      </div>
    </header>

    <!-- KPI Cards con aria-live para contadores -->
    <section class="stats-grid" aria-label="Resumen de citas">
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="statTotal" data-target="284" aria-live="polite">0</span>
        <span class="stat-label">Total Citas</span>
        <span class="stat-sub">Este mes</span>
      </div>
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="statScheduled" data-target="48" aria-live="polite">0</span>
        <span class="stat-label">Programadas</span>
        <span class="stat-sub">↑ +12 vs semana pasada</span>
      </div>
      <div class="stat-card" data-color="red">
        <span class="stat-number" id="statCancelled" data-target="12" aria-live="polite">0</span>
        <span class="stat-label">Canceladas</span>
        <span class="stat-sub">Tasa: 4.2%</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number" id="statAttended" data-target="224" aria-live="polite">0</span>
        <span class="stat-label">Atendidas</span>
        <span class="stat-sub">↑ 79% asistencia</span>
      </div>
    </section>

    <form method="post" asp-action="GuardarCita" asp-controller="GestionCitas" class="table-section" aria-labelledby="tableTitle">
      @Html.AntiForgeryToken()
      <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
      <input type="hidden" name="IdCita" value="@(((SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"])?.IdCita ?? 0)" />
      <div class="table-filters" style="margin-bottom:16px;">
        <select name="IdPaciente" class="filter-select" required>
          <option value="">Seleccione paciente</option>
          @foreach (var paciente in pacientes)
          {
            var editingCita = (SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"];
            var selected = editingCita?.IdPaciente == paciente.IdPaciente ? "selected" : "";
            <option value="@paciente.IdPaciente" selected="@(selected)">@paciente.NombresCompleto</option>
          }
        </select>
        <select name="IdProfesional" class="filter-select">
          <option value="">Seleccione profesional</option>
          @foreach (var profesional in profesionales)
          {
            var editingCita = (SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"];
            var selected = editingCita?.IdProfesional == profesional.IdProfesional ? "selected" : "";
            <option value="@profesional.IdProfesional" selected="@(selected)">@profesional.NombreProfesional</option>
          }
        </select>
        <select name="IdServicio" class="filter-select">
          <option value="">Seleccione servicio</option>
          @foreach (var servicio in servicios)
          {
            var editingCita = (SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"];
            var selected = editingCita?.IdServicio == servicio.IdServicio ? "selected" : "";
            <option value="@servicio.IdServicio" selected="@(selected)">@servicio.Nombre</option>
          }
        </select>
        <input type="datetime-local" name="FechaHora" class="filter-date" value="@(((SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"])?.FechaHora.ToString("yyyy-MM-ddTHH:mm") ?? DateTime.UtcNow.AddDays(1).ToString("yyyy-MM-ddTHH:mm"))" required />
        <select name="Estado" class="filter-select">
          @{ var editingCitaEstado = (SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"]; }
          <option value="programada" selected="@(editingCitaEstado?.Estado == "programada")">Programada</option>
          <option value="confirmada" selected="@(editingCitaEstado?.Estado == "confirmada")">Confirmada</option>
          <option value="atendida" selected="@(editingCitaEstado?.Estado == "atendida")">Atendida</option>
          <option value="cancelada" selected="@(editingCitaEstado?.Estado == "cancelada")">Cancelada</option>
        </select>
        <textarea name="Notas" class="search-input" placeholder="Notas">@(((SmileTrack_MVC.Models.Entities.Cita?)ViewData["EditingCita"])?.Notas)</textarea>
        <button class="btn-primary" type="submit">@(ViewData["EditingCita"] != null ? "Guardar cambios" : "Crear cita")</button>
      </div>
    </form>

    <section class="table-section" aria-labelledby="tableTitle">
      <h2 class="visually-hidden" id="tableTitle">Lista de citas</h2>

      <!-- Tabs accesibles -->
      <div class="table-tabs" role="tablist" aria-label="Filtrar citas por estado">
        <button class="tab-btn active" data-tab="all" role="tab" aria-selected="true" aria-controls="citasBody">Todas
          las citas</button>
        <button class="tab-btn" data-tab="cancelled" role="tab" aria-selected="false"
          aria-controls="citasBody">Cancelaciones</button>
        <button class="tab-btn" data-tab="no-show" role="tab" aria-selected="false" aria-controls="citasBody">No
          asistió</button>
      </div>

      <!-- Filtros -->
      <form method="get" class="table-filters">
        <div class="search-wrap">
          <span class="search-icon" aria-hidden="true">🔍</span>
          <input type="search" id="searchAppointments" name="search" class="search-input" placeholder="Buscar paciente..."
            aria-label="Buscar paciente" value="@ViewData["SearchFilter"]">
        </div>
        <select id="filterStatus" name="estado" class="filter-select" aria-label="Filtrar por estado">
          <option value="">Todos los estados</option>
          @if (ViewData["EstadoFilter"]?.ToString() == "programada")
          {
            <option value="programada" selected>Programada</option>
          }
          else
          {
            <option value="programada">Programada</option>
          }
          @if (ViewData["EstadoFilter"]?.ToString() == "confirmada")
          {
            <option value="confirmada" selected>Confirmada</option>
          }
          else
          {
            <option value="confirmada">Confirmada</option>
          }
          @if (ViewData["EstadoFilter"]?.ToString() == "atendida")
          {
            <option value="atendida" selected>Atendida</option>
          }
          else
          {
            <option value="atendida">Atendida</option>
          }
          @if (ViewData["EstadoFilter"]?.ToString() == "cancelada")
          {
            <option value="cancelada" selected>Cancelada</option>
          }
          else
          {
            <option value="cancelada">Cancelada</option>
          }
        </select>
        <select id="filterProfessional" name="profesional" class="filter-select" aria-label="Filtrar por profesional">
          <option value="">Cualquier profesional</option>
          @foreach (var profesional in profesionalesFilterOptions)
          {
            if (ViewData["ProfesionalFilter"]?.ToString() == profesional.IdProfesional.ToString())
            {
              <option value="@profesional.IdProfesional" selected>@profesional.NombreProfesional</option>
            }
            else
            {
              <option value="@profesional.IdProfesional">@profesional.NombreProfesional</option>
            }
          }
        </select>
        <input type="date" id="filterDate" name="fecha" class="filter-date" aria-label="Filtrar por fecha" value="@ViewData["FechaFilter"]">
        <input type="hidden" name="page" value="1" />
        <button class="btn-primary" type="submit">Aplicar filtros</button>
        <a class="btn-secondary" href="@Url.Action("Stadm09Citas", "GestionCitas")">Limpiar</a>
      </form>

      <!-- Cabecera de tabla accesible -->
      <div class="table-header" role="row">
        <div class="table-col col-fecha" role="columnheader">Fecha</div>
        <div class="table-col col-hora" role="columnheader">Hora</div>
        <div class="table-col col-paciente" role="columnheader">Paciente</div>
        <div class="table-col col-profesional" role="columnheader">Profesional</div>
        <div class="table-col col-servicio" role="columnheader">Servicio</div>
        <div class="table-col col-estado text-center" role="columnheader">Estado</div>
        <div class="table-col col-acciones text-right" role="columnheader">Acciones</div>
      </div>

      <!-- Cuerpo de tabla con aria-live -->
      <div id="citasBody" class="table-body" role="rowgroup" aria-live="polite">
        @foreach (var cita in citas)
        {
          <div class="table-row" role="row">
            <div class="table-col col-fecha" role="cell">@cita.FechaHora.ToString("dd/MM/yyyy")</div>
            <div class="table-col col-hora" role="cell">@cita.FechaHora.ToString("HH:mm")</div>
            <div class="table-col col-paciente" role="cell">@cita.Paciente?.NombresCompleto</div>
            <div class="table-col col-profesional" role="cell">@cita.Profesional?.NombreProfesional</div>
            <div class="table-col col-servicio" role="cell">@cita.Servicio?.Nombre</div>
            <div class="table-col col-estado text-center" role="cell"><span class="status-badge @((cita.Estado ?? string.Empty).ToLowerInvariant())">@cita.Estado</span></div>
            <div class="table-col col-acciones text-right" role="cell">
              <a class="action-btn" href="@Url.Action("Stadm09Citas", "GestionCitas", new { editId = cita.IdCita })">✏️</a>
              <form method="post" asp-action="EliminarCita" asp-controller="GestionCitas" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdCita" value="@cita.IdCita" />
                <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                <button class="action-btn btn-delete" type="submit" onclick="return confirm('¿Eliminar esta cita?');">❌</button>
              </form>
            </div>
          </div>
        }
      </div>

      <!-- Paginación accesible -->
      <footer class="table-footer" aria-label="Navegación de páginas">
        @{ }
        <span>Mostrando <strong id="pageShowing">@Math.Min(pageResult?.PageSize ?? 10, pageResult?.Items.Count ?? 0)</strong> de <strong id="pageTotal">@pageResult?.TotalCount</strong> citas</span>
        <nav class="pagination" aria-label="Páginas de resultados">
          @if (pageResult != null && pageResult.HasPreviousPage)
          {
            <a class="pagination-btn" aria-label="Página anterior" href="@Url.Action("Stadm09Citas", "GestionCitas", new { page = pageResult.Page - 1, pageSize = pageResult.PageSize, search = ViewData["SearchFilter"], estado = ViewData["EstadoFilter"], profesional = ViewData["ProfesionalFilter"], fecha = ViewData["FechaFilter"] })">‹</a>
          }
          else
          {
            <button class="pagination-btn" aria-label="Página anterior" disabled>‹</button>
          }
          @for (var i = 1; i <= (pageResult?.TotalPages ?? 1); i++)
          {
            var isActive = i == (pageResult?.Page ?? 1);
            <a class="pagination-btn @(isActive ? "active" : string.Empty)" aria-current="@(isActive ? "page" : null)" aria-label="Página @i" href="@Url.Action("Stadm09Citas", "GestionCitas", new { page = i, pageSize = pageResult?.PageSize ?? 10, search = ViewData["SearchFilter"], estado = ViewData["EstadoFilter"], profesional = ViewData["ProfesionalFilter"], fecha = ViewData["FechaFilter"] })">@i</a>
          }
          @if (pageResult != null && pageResult.HasNextPage)
          {
            <a class="pagination-btn" aria-label="Página siguiente" href="@Url.Action("Stadm09Citas", "GestionCitas", new { page = pageResult.Page + 1, pageSize = pageResult.PageSize, search = ViewData["SearchFilter"], estado = ViewData["EstadoFilter"], profesional = ViewData["ProfesionalFilter"], fecha = ViewData["FechaFilter"] })">›</a>
          }
          else
          {
            <button class="pagination-btn" aria-label="Página siguiente" disabled>›</button>
          }
        </nav>
      </footer>
    </section>

    <!-- Banner informativo -->
    <section class="info-banner" role="complementary" aria-label="Resumen de disponibilidad">
      <div class="banner-content">
        <h3 class="banner-title">Resumen de Disponibilidad</h3>
        <p class="banner-text">El Dr. Ricardo Méndez tiene 85% de su agenda ocupada esta semana. Considere reasignar
          citas de limpieza a la Dra. Elena.</p>
      </div>
      <button class="btn-banner" id="btnOptimize" aria-label="Optimizar agenda automáticamente">Optimizar
        Agenda</button>
    </section>

  </main>

  <!-- Modal: Detalle de Cita -->
  <div class="modal-overlay" id="modalAppointment" role="dialog" aria-modal="true"
    aria-labelledby="modalAppointmentTitle" aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalAppointmentClose" aria-label="Cerrar ventana">×</button>
      <h2 class="modal-title" id="modalAppointmentTitle">Detalle de Cita</h2>
      <div id="modalAppointmentContent" class="modal-content" role="document"></div>
      <div class="modal-footer">
        <button class="btn-secondary" id="modalAppointmentCancel">Cerrar</button>
        <button class="btn-primary" id="modalAppointmentEdit">Editar</button>
      </div>
    </div>
  </div>

  <!-- Mobile bottom nav -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-adm-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📊</span>
      <span>Dashboard</span>
    </a>
    <a href="#" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon" aria-hidden="true">🗓️</span>
      <span>Citas</span>
    </a>
    <a href="/gestion-de-citas/st-adm-08-agenda" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📅</span>
      <span>Agenda</span>
    </a>
  </nav>

  <!-- Toast para notificaciones accesibles -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;">🦷</span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>


  <script src="@Url.Content("~/js/Gestion_De_Citas/st-adm-09-citas/gestionintegral.js")"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.nav-group-header').forEach(header => {
      const items = header.nextElementSibling;
      const arrow = header.querySelector('.nav-arrow');

      if (!items || !arrow) return;

      const setExpanded = (isExpanded) => {
        items.style.maxHeight = isExpanded ? `${items.scrollHeight}px` : '0px';
        arrow.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
        header.setAttribute('aria-expanded', String(isExpanded));
      };

      setExpanded(false);

      const toggle = () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        setExpanded(!isExpanded);
      };

      header.addEventListener('click', toggle);
      header.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  });
</script>
</body>

</html>
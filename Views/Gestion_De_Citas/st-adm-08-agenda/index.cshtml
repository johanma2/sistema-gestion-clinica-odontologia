@{ Layout = null; var agendaDias = ViewData["AgendaDias"] as List<SmileTrack_MVC.Models.ViewModels.AgendaDiaViewModel> ?? new(); var semanaLabel = ViewData["SemanaLabel"] ?? string.Empty; }

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Gestión de citas y horarios en la agenda general de SmileTrack" />
  <title>SmileTrack — Agenda General</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Gestion_De_Citas/st-adm-08-agenda/agendageneral.css")" />
</head>

<body>

  <!-- Enlace para saltar al contenido principal (accesibilidad) -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <aside class="sidebar" id="sidebar" aria-label="Navegación principal">
    <div class="sidebar-logo">
      <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="SmileTrack" class="logo-img" />
    </div>
    @{ await Html.RenderPartialAsync("_SidebarAdmin"); }
                <div class="sidebar-user">
      <div class="user-avatar" aria-hidden="true">@(User.Identity?.Name?.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpperInvariant() : (User.Identity?.Name?.ToUpperInvariant() ?? "U"))</div>
      <div class="user-info">
        <span class="user-role">@User.Identity?.Name</span>
        <span class="user-email">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
      </div>
    </div>
  </aside>


  <!--  HAMBURGER (móvil)  -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- MAIN -->
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Administración</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Agenda General</span>
        </nav>
        <h1 class="page-title">Agenda General</h1>
        <p class="page-subtitle">Gestión de citas y horarios</p>
      </div>
    </header>

    <!-- Controles de agenda -->
    <section class="agenda-controls" aria-label="Controles de navegación y filtros">
      <div class="controls-left">
        <div class="week-nav" role="navigation" aria-label="Navegación semanal">
          <button class="btn-week" id="btnPrev" aria-label="Semana anterior">
            <span aria-hidden="true"> < </span>
          </button>
          <span class="week-label" id="weekLabel" aria-live="polite">@semanaLabel</span>
          <button class="btn-week" id="btnNext" aria-label="Próxima semana">
            <span aria-hidden="true"> > </span>
          </button>
        </div>
        <button class="btn-primary" id="btnToday" aria-label="Ir a la semana actual">
          📅 Hoy
        </button>
      </div>
      <div class="controls-right">
        <div class="filter-group">
          <label for="filterProfessional" class="filter-label">Profesional</label>
          <select id="filterProfessional" class="status-select" aria-label="Filtrar por profesional">
            <option value="">Todos los profesionales</option>
            <option value="1">Dr. Javier Mendez</option>
            <option value="2">Dra. Lucía Torres</option>
            <option value="3">Dr. Roberto Sanz</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="filterOffice" class="filter-label">Consultorio</label>
          <select id="filterOffice" class="status-select" aria-label="Filtrar por consultorio">
            <option value="">Todos los consultorios</option>
            <option value="1">Box 01 - General</option>
            <option value="2">Box 02 - Cirugía</option>
            <option value="3">Box 03 - Ortodoncia</option>
          </select>
        </div>
        <div class="filter-actions">
          <button class="btn-icon" id="btnFilter" aria-label="Aplicar filtros"></button>
          <button class="btn-icon" id="btnDownload" aria-label="Descargar agenda"></button>
        </div>
      </div>
    </section>

    <!-- Calendario semanal -->
    <section class="calendar-section" aria-labelledby="calendarTitle">
      <h2 class="visually-hidden" id="calendarTitle">Calendario semanal de citas</h2>

      <!-- Cabecera de dÃ­as -->
      <div class="calendar-header" role="row">
        <div class="calendar-day-header" role="columnheader">
          <span class="day-name">Lun</span>
          <time datetime="2026-05-19" class="day-number">19</time>
        </div>
        <div class="calendar-day-header" role="columnheader">
          <span class="day-name">Mar</span>
          <time datetime="2026-05-20" class="day-number">20</time>
        </div>
        <div class="calendar-day-header current" role="columnheader" aria-current="date">
          <span class="day-name">Mié</span>
          <time datetime="2026-05-21" class="day-number">21</time>
          <span class="day-indicator" aria-hidden="true"></span>
        </div>
        <div class="calendar-day-header" role="columnheader">
          <span class="day-name">Jue</span>
          <time datetime="2026-05-22" class="day-number">22</time>
        </div>
        <div class="calendar-day-header" role="columnheader">
          <span class="day-name">Vie</span>
          <time datetime="2026-05-23" class="day-number">23</time>
        </div>
        <div class="calendar-day-header" role="columnheader">
          <span class="day-name">Sáb</span>
          <time datetime="2026-05-24" class="day-number">24</time>
        </div>
        <div class="calendar-day-header closed" role="columnheader" aria-label="Domingo: cerrado">
          <span class="day-name">Dom</span>
          <time datetime="2026-05-25" class="day-number">25</time>
        </div>
      </div>

      <!-- Cuerpo del calendario -->
      <div class="calendar-body" role="grid" aria-label="Citas por dí­a">
        @foreach (var dia in agendaDias)
        {
          <div class="calendar-day @(dia.EsHoy ? "current" : string.Empty) @(dia.Cerrado ? "closed" : string.Empty)" role="row" aria-labelledby="day-@dia.Fecha.ToString("yyyyMMdd")">
            <span id="day-@dia.Fecha.ToString("yyyyMMdd")" class="visually-hidden">@dia.NombreDia @dia.Fecha.Day de @dia.Fecha.ToString("MMMM")</span>
            @if (dia.Cerrado)
            {
              <div class="day-closed">
                <span aria-hidden="true"></span>
                <span>CERRADO</span>
              </div>
            }
            else
            {
              @foreach (var cita in dia.Citas)
              {
                <div class="appointment @cita.ClaseEstado" tabindex="0" role="button" aria-label="Cita @cita.Estado: @cita.Paciente, @cita.Hora, @cita.Servicio, @cita.Consultorio">
                  <time datetime="@dia.Fecha.ToString("yyyy-MM-dd")T@cita.Hora:00" class="appt-time">@cita.Hora</time>
                  <span class="appt-patient">@cita.Paciente</span>
                  <span class="appt-detail">@cita.Servicio Â· @cita.Consultorio</span>
                </div>
              }
              @if (!dia.Citas.Any())
              {
                <div class="appointment available" tabindex="0" role="button" aria-label="Sin citas registradas para @dia.Fecha.ToString("dd/MM")">
                  <time datetime="@dia.Fecha.ToString("yyyy-MM-dd")" class="appt-time"></time>
                  <span class="appt-patient">Sin citas</span>
                </div>
              }
            }
          </div>
        }
      </div>
    </section>

    <!-- Leyenda de estados -->
    <section class="legend-section" aria-labelledby="legendTitle">
      <h2 class="section-title" id="legendTitle">Estados de cita</h2>
      <div class="legend-grid">
        <div class="legend-item">
          <span class="legend-dot confirmed" aria-hidden="true"></span>
          <span>Confirmada</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot attended" aria-hidden="true"></span>
          <span>Asistida</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot cancelled" aria-hidden="true"></span>
          <span>Cancelada</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot available" aria-hidden="true"></span>
          <span>Disponible</span>
        </div>
      </div>
    </section>

  </main>

  <!-- Modal: Detalle de cita -->
  <div class="modal-overlay" id="modalAppointment" role="dialog" aria-modal="true" aria-labelledby="modalApptTitle"
    aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalApptClose" aria-label="Cerrar ventana">×</button>
      <h2 class="modal-title" id="modalApptTitle">Detalle de Cita</h2>
      <div class="modal-content" id="modalApptContent">
        <!-- Contenido inyectado por JS -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modalApptCancel">Cerrar</button>
        <button type="button" class="btn-primary" id="modalApptEdit">Editar</button>
      </div>
    </div>
  </div>

  <!-- Modal: Crear nueva cita -->
  <div class="modal-overlay" id="modalNewAppointment" role="dialog" aria-modal="true" aria-labelledby="modalNewApptTitle"
    aria-hidden="true" inert>
    <div class="modal modal-lg">
      <button class="modal-close" id="modalNewApptClose" aria-label="Cerrar ventana">×</button>
      <h2 class="modal-title" id="modalNewApptTitle">Agendar Nueva Cita</h2>
      <div class="modal-content">
        <form id="formNewAppointment">
          @Html.AntiForgeryToken()
          <div class="form-grid">
            <!-- Fecha -->
            <div class="form-group">
              <label for="newApptDate">Fecha</label>
              <input type="date" id="newApptDate" name="Fecha" required aria-required="true" />
            </div>
            <!-- Estado -->
            <div class="form-group">
              <label for="newApptStatus">Estado</label>
              <select id="newApptStatus" name="Estado" required aria-required="true">
                <option value="Agendada" selected>Agendada</option>
                <option value="Confirmada">Confirmada</option>
              </select>
            </div>
            <!-- Hora Inicio -->
            <div class="form-group">
              <label for="newApptStartTime">Hora Inicio</label>
              <input type="time" id="newApptStartTime" name="HoraInicio" required aria-required="true" />
            </div>
            <!-- Hora Fin -->
            <div class="form-group">
              <label for="newApptEndTime">Hora Fin</label>
              <input type="time" id="newApptEndTime" name="HoraFin" required aria-required="true" />
            </div>
            
            <!-- Paciente -->
            <div class="form-group full-width">
              <label for="newApptPatient">Paciente</label>
              <select id="newApptPatient" name="IdPaciente" required aria-required="true" data-placeholder="Buscar paciente...">
                <option value="">Seleccione paciente...</option>
                @if (ViewBag.Pacientes != null)
                {
                  foreach (var p in ViewBag.Pacientes)
                  {
                    <option value="@p.IdPaciente">@p.DisplayName</option>
                  }
                }
              </select>
            </div>
            <!-- Profesional -->
            <div class="form-group">
              <label for="newApptProfessional">Profesional</label>
              <select id="newApptProfessional" name="IdProfesional" required aria-required="true">
                <option value="">Seleccione profesional</option>
                @if (ViewBag.Profesionales != null)
                {
                  foreach (var p in ViewBag.Profesionales)
                  {
                    <option value="@p.IdProfesional">@p.DisplayName</option>
                  }
                }
              </select>
            </div>
            <!-- Consultorio -->
            <div class="form-group">
              <label for="newApptOffice">Consultorio</label>
              <select id="newApptOffice" name="IdConsultorio" required aria-required="true">
                <option value="">Seleccione consultorio</option>
                @if (ViewBag.Consultorios != null)
                {
                  foreach (var c in ViewBag.Consultorios)
                  {
                    <option value="@c.IdConsultorio">@c.Nombre</option>
                  }
                }
              </select>
            </div>
            <!-- Servicio -->
            <div class="form-group full-width">
              <label for="newApptService">Servicio (Motivo de Consulta)</label>
              <select id="newApptService" name="IdServicio" required aria-required="true">
                <option value="">Seleccione servicio</option>
                @if (ViewBag.Servicios != null)
                {
                  foreach (var s in ViewBag.Servicios)
                  {
                    <option value="@s.IdServicio">@s.Nombre</option>
                  }
                }
              </select>
            </div>
            <!-- Notas -->
            <div class="form-group full-width">
              <label for="newApptNotes">Observaciones</label>
              <textarea id="newApptNotes" name="Notas" rows="2" placeholder="Detalles adicionales..."></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-secondary" id="modalNewApptCancel">Cancelar</button>
            <button type="submit" class="btn-primary" id="modalNewApptSave">Guardar Cita</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- FAB: Nueva cita -->
  <button class="fab" id="btnNewAppointment" aria-label="Crear nueva cita">
    <span aria-hidden="true">+</span>
  </button>

  <!-- Mobile bottom nav -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-adm-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true"></span>
      <span>Dashboard</span>
    </a>
    <a href="#" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon" aria-hidden="true"></span>
      <span>Agenda</span>
    </a>
    <a href="/gestion-de-citas/st-adm-09-citas" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true"></span>
      <span>Citas</span>
    </a>
  </nav>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;">🦷</span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.nav-group-header').forEach(header => {
      const items = header.nextElementSibling;
      const arrow = header.querySelector('.nav-arrow');

      if (!items || !arrow) return;

      const setExpanded = (isExpanded) => {
        items.style.maxHeight = isExpanded ? `${items.scrollHeight}px` : '0px';
        arrow.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
        header.setAttribute('aria-expanded', String(isExpanded));
      };

      setExpanded(false);

      const toggle = () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        setExpanded(!isExpanded);
      };

      header.addEventListener('click', toggle);
      header.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  });
</script>
  <script src="@Url.Content("~/js/Gestion_De_Citas/st-adm-08-agenda/agendageneral.js")"></script>
</body>

</html>




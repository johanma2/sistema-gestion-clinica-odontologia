  <div class="sidebar-user">
    <div class="user-avatar" aria-hidden="true">AU</div>
    <div class="user-info">
      <span class="user-role">Auxiliar</span>
      <span class="user-email">auxiliar@smiletrack.co</span>
    </div>
  </div>
</aside>

  <!-- Botón hamburguesa para menú móvil, con atributos ARIA para accesibilidad -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Page header con metadatos del paciente -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Auxiliar</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Historial Clínico</span>
        </nav>
        <h1 class="page-title">Historial Clínico — Solo Lectura</h1>
        <p class="page-subtitle" id="patientMeta" aria-live="polite">Cargando...</p>
      </div>
    </header>

    <!-- Contenido principal -->
    <div class="content">

      <!-- Alerta médica con role alert para anuncio inmediato -->
      <div class="alerta-medica" id="alertaMedica" role="alert" aria-live="assertive">
        <div class="alerta-medica-title">
          <span aria-hidden="true">⚠️</span>
          <span>ALERTA MÉDICA — LEER ANTES DE PROCEDER</span>
        </div>
        <div class="alerta-medica-row">
          <span class="alerta-medica-icon" aria-hidden="true">🚨</span>
          <span><strong>Alergia:</strong> <span class="alerta-medica-value red" id="alergia"
              aria-live="polite">—</span></span>
        </div>
        <div class="alerta-medica-row">
          <span class="alerta-medica-icon" aria-hidden="true">💊</span>
          <span><strong>Medicamentos:</strong> <span class="alerta-medica-value" id="medicamentos"
              aria-live="polite">—</span></span>
        </div>
        <div class="alerta-medica-row">
          <span class="alerta-medica-icon" aria-hidden="true">🩸</span>
          <span><strong>Grupo sanguíneo:</strong> <span class="alerta-medica-value" id="grupoSang"
              aria-live="polite">—</span></span>
        </div>
      </div>

      <!-- Tabla de historial con estructura accesible -->
      <div class="table-card">
        <div class="table-scroll">
          <table class="hist-table" aria-label="Historial de consultas del paciente">
            <thead>
              <tr>
                <th scope="col">FECHA</th>
                <th scope="col">PROFESIONAL</th>
                <th scope="col">DIAGNÓSTICO</th>
                <th scope="col">PROCEDIMIENTO</th>
              </tr>
            </thead>
            <tbody id="histBody" aria-live="polite">
              <!-- Skeleton loader inicial para feedback visual durante carga -->
              <tr class="skeleton-row">
                <td>
                  <div class="skeleton-cell" style="width:80px" aria-hidden="true"></div>
                </td>
                <td>
                  <div class="skeleton-cell" style="width:130px" aria-hidden="true"></div>
                </td>
                <td>
                  <div class="skeleton-cell" style="width:90%" aria-hidden="true"></div>
                </td>
                <td>
                  <div class="skeleton-cell" style="width:90%" aria-hidden="true"></div>
                </td>
              </tr>
              <tr class="skeleton-row">
                <td>
                  <div class="skeleton-cell" style="width:80px" aria-hidden="true"></div>
                </td>
                <td>
                  <div class="skeleton-cell" style="width:130px" aria-hidden="true"></div>
                </td>
                <td>
                  <div class="skeleton-cell" style="width:90%" aria-hidden="true"></div>
                </td>
                <td>
                  <div class="skeleton-cell" style="width:90%" aria-hidden="true"></div>
                </td>
              </tr>
              <tr class="skeleton-row">
                <td>
                  <div class="skeleton-cell" style="width:80px" aria-hidden="true"></div>
                </td>
                <td>
                  <div class="skeleton-cell" style="width:130px" aria-hidden="true"></div>
                </td>
                <td>
                  <div class="skeleton-cell" style="width:90%" aria-hidden="true"></div>
                </td>
                <td>
                  <div class="skeleton-cell" style="width:90%" aria-hidden="true"></div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="table-footer" id="tableFooter" role="note">
          Solo se muestran las últimas 3 consultas. Para ver el historial completo contacta a tu supervisor.
        </div>
      </div>

    </div>

  </main>

  <!-- Toast container con atributos ARIA para notificaciones -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para contenido solo accesible por screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">

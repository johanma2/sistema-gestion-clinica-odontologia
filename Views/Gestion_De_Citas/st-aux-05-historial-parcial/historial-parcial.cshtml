      <div class="nav-group-items">
        <a href="/historia-clinica/st-aux-07-control-postoperato" class="nav-item" data-icon="🏥">Control Postoperatorio</a>
        <a href="/historia-clinica/st-aux-08-documentos-clinicos" class="nav-item" data-icon="📎">Documentos Clínicos</a>

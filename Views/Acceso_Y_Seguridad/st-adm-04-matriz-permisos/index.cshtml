@{ Layout = null; }
    
<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Configura permisos por rol y módulo en SmileTrack" />
  <title>SmileTrack — Matriz de Permisos</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Acceso_Y_Seguridad/st-adm-04-matriz-permisos/styles.css")" />
</head>

<body>

  <!-- Enlace para saltar al contenido principal (accesibilidad) -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <!-- ═════ SIDEBAR UNIFICADO (Activo: Matriz Permisos) ═════ -->
  
<aside class="sidebar" id="sidebar" aria-label="Navegación principal">
  <div class="sidebar-logo">
    <img src="@Url.Content("~/images/Imagenes/Logos/logo.jpg")" alt="SmileTrack" class="logo-img" />
  </div>
  @{ await Html.RenderPartialAsync("_SidebarAdmin"); }
  <div class="sidebar-user">
    <div class="user-avatar" aria-hidden="true">AD</div>
    <div class="user-info">
      <span class="user-role">Administrador</span>
      <span class="user-email">admin@smiletrack.co</span>
    </div>
  </div>
</aside>



  <!-- ═════ HAMBURGER (móvil) ═════ -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Administración</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Matriz de Permisos</span>
        </nav>
        <h1 class="page-title">Matriz de Permisos por Módulo</h1>
        <p class="page-subtitle">Configura qué puede hacer cada rol en cada módulo del sistema</p>
      </div>
      <div class="header-actions">
        <div class="search-wrap">
          <span class="search-icon" aria-hidden="true">🔍</span>
          <input type="search" id="searchModules" class="search-input" placeholder="Buscar módulo..."
            aria-label="Buscar módulo">
        </div>
        <button class="btn-primary" id="btnSaveConfig" aria-label="Guardar configuración de permisos">
          💾 Guardar configuración
        </button>
      </div>
    </header>

    <!-- Tabla de matriz de permisos -->
    <section class="matrix-section" aria-labelledby="matrixTitle">
      <h2 class="visually-hidden" id="matrixTitle">Matriz de permisos por módulo y rol</h2>

      <!-- Cabecera de la tabla -->
      <div class="matrix-header" role="row">
        <div class="matrix-col-module" role="columnheader">Módulo</div>
        <div class="matrix-col-roles" role="row">
          <div class="matrix-role-header" role="columnheader" aria-label="Administrador">
            <span class="role-badge admin">ADM</span>
          </div>
          <div class="matrix-role-header" role="columnheader" aria-label="Odontólogo">
            <span class="role-badge odo">ODO</span>
          </div>
          <div class="matrix-role-header" role="columnheader" aria-label="Paciente">
            <span class="role-badge pac">PAC</span>
          </div>
          <div class="matrix-role-header" role="columnheader" aria-label="Recepción">
            <span class="role-badge rec">REC</span>
          </div>
          <div class="matrix-role-header" role="columnheader" aria-label="Auxiliar">
            <span class="role-badge aux">AUX</span>
          </div>
        </div>
      </div>

      <!-- Cuerpo de la matriz (renderizado por JS) -->
      <div id="matrixBody" class="matrix-body" role="rowgroup" aria-live="polite">
        <!-- Filas inyectadas por JS -->
      </div>

      <!-- Estado vacío -->
      <div class="empty-state" id="emptyState" style="display:none" role="status" aria-live="polite" aria-hidden="true">
        No se encontraron módulos con los criterios de búsqueda.
      </div>
    </section>

    <!-- Leyenda de permisos -->
    <section class="legend-section" aria-labelledby="legendTitle">
      <h2 class="section-title" id="legendTitle">Glosario de permisos</h2>
      <div class="legend-grid">
        <div class="legend-item">
          <span class="legend-dot crud" aria-hidden="true"></span>
          <div>
            <strong>CRUD</strong>
            <p>Acceso total: Crear, Leer, Actualizar, Eliminar</p>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-dot cru" aria-hidden="true"></span>
          <div>
            <strong>CRU</strong>
            <p>Crear, Leer, Actualizar (sin eliminar)</p>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-dot ru" aria-hidden="true"></span>
          <div>
            <strong>RU</strong>
            <p>Leer y Actualizar (solo edición)</p>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-dot r" aria-hidden="true"></span>
          <div>
            <strong>R</strong>
            <p>Solo Lectura (consulta)</p>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-dot c" aria-hidden="true"></span>
          <div>
            <strong>C</strong>
            <p>Solo Creación (registro)</p>
          </div>
        </div>
        <div class="legend-item">
          <span class="legend-dot none" aria-hidden="true"></span>
          <div>
            <strong>—</strong>
            <p>Sin acceso al módulo</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Estado del pie de página -->
    <footer class="page-footer" aria-live="polite">
      <span class="status-dot" aria-hidden="true"></span>
      <span id="footerStatus">Permisos sincronizados correctamente</span>
    </footer>

  </main>

  <!-- Modal: Editar permiso -->
  <div class="modal-overlay" id="modalEdit" role="dialog" aria-modal="true" aria-labelledby="modalTitle"
    aria-hidden="true" inert>
    <div class="modal">
      <button class="modal-close" id="modalClose" aria-label="Cerrar ventana">×</button>
      <h2 class="modal-title" id="modalTitle">Editar Permiso</h2>
      <p class="modal-subtitle" id="modalSubtitle">Módulo: <strong id="modalModule"></strong> · Rol: <strong
          id="modalRole"></strong></p>

      <form id="formPermission" class="permission-form">
        <fieldset class="permission-options" role="radiogroup" aria-label="Nivel de acceso">
          <label class="permission-option">
            <input type="radio" name="permLevel" value="CRUD" class="perm-radio">
            <span class="perm-label">
              <span class="perm-badge crud">CRUD</span>
              <span class="perm-desc">Acceso total: Crear, Leer, Actualizar, Eliminar</span>
            </span>
          </label>
          <label class="permission-option">
            <input type="radio" name="permLevel" value="CRU" class="perm-radio">
            <span class="perm-label">
              <span class="perm-badge cru">CRU</span>
              <span class="perm-desc">Crear, Leer, Actualizar (sin eliminar)</span>
            </span>
          </label>
          <label class="permission-option">
            <input type="radio" name="permLevel" value="RU" class="perm-radio">
            <span class="perm-label">
              <span class="perm-badge ru">RU</span>
              <span class="perm-desc">Leer y Actualizar (solo edición)</span>
            </span>
          </label>
          <label class="permission-option">
            <input type="radio" name="permLevel" value="R" class="perm-radio">
            <span class="perm-label">
              <span class="perm-badge r">R</span>
              <span class="perm-desc">Solo Lectura (consulta)</span>
            </span>
          </label>
          <label class="permission-option">
            <input type="radio" name="permLevel" value="C" class="perm-radio">
            <span class="perm-label">
              <span class="perm-badge c">C</span>
              <span class="perm-desc">Solo Creación (registro)</span>
            </span>
          </label>
          <label class="permission-option">
            <input type="radio" name="permLevel" value="-" class="perm-radio">
            <span class="perm-label">
              <span class="perm-badge none">—</span>
              <span class="perm-desc">Sin acceso al módulo</span>
            </span>
          </label>
        </fieldset>

        <div class="modal-footer">
          <button type="button" class="btn-secondary" id="modalCancel">Cancelar</button>
          <button type="submit" class="btn-primary">Aplicar cambio</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Mobile bottom nav -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-citas/st-adm-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📊</span>
      <span>Dashboard</span>
    </a>
    <a href="/acceso-y-seguridad/st-adm-02-gestion-usuarios" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">👥</span>
      <span>Usuarios</span>
    </a>
    <a href="#" class="mobile-nav-item active" aria-current="page">
      <span class="mobile-nav-icon" aria-hidden="true">🔐</span>
      <span>Permisos</span>
    </a>
    <a href="/facturacion-y-pagos/st-adm-12-facturacion" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">💳</span>
      <span>Facturación</span>
    </a>
    <a href="/servicios-y-recursos/st-adm-16-configuracion-general" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">⚙️</span>
      <span>Config</span>
    </a>
  </nav>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;">🦷</span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>


  <script src="@Url.Content("~/js/Acceso_Y_Seguridad/st-adm-04-matriz-permisos/script.js")"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.nav-group-header').forEach(header => {
      const items = header.nextElementSibling;
      const arrow = header.querySelector('.nav-arrow');

      if (!items || !arrow) return;

      const setExpanded = (isExpanded) => {
        items.style.maxHeight = isExpanded ? `${items.scrollHeight}px` : '0px';
        arrow.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
        header.setAttribute('aria-expanded', String(isExpanded));
      };

      setExpanded(false);

      const toggle = () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        setExpanded(!isExpanded);
      };

      header.addEventListener('click', toggle);
      header.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  });
</script>
</body>

</html>
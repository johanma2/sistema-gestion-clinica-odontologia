@{ Layout = null; }

﻿<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmileTrack — Odontograma Digital</title>
  <meta name="description"
    content="Visualiza y gestiona el estado dental de tus pacientes con el odontograma digital de SmileTrack." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
    rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Historia_Clinica/st-odo-04-odontograma/odontograma-digital.css")" />
</head>

<body>

  <!-- Enlace para saltar al contenido principal, accesibilidad keyboard-first -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  @{ await Html.RenderPartialAsync("_SidebarProfesional"); }

  <!-- Botón hamburguesa para menú móvil, con atributos ARIA -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Header con metadatos accesibles -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Odontólogo</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Odontograma Digital</span>
        </nav>
        <h1 class="page-title">Odontograma Digital</h1>
        <p class="page-subtitle">
          <time datetime="" id="headerDate" aria-live="polite">Cargando fecha…</time> ·
          <span id="patientName" aria-label="Paciente: Cargando…">Cargando…</span> ·
          <span id="patientHC" aria-label="Código de historia clínica"></span> ·
          <span id="dentitionType" aria-label="Tipo de dentición">Cargando…</span>
        </p>
      </div>
      <div class="page-header-actions">
        <div class="tipo-tabs" role="tablist" aria-label="Seleccionar tipo de dentición">
          <button class="tipo-btn active" id="btnAdulto" data-tipo="adulto" role="tab" aria-selected="true"
            aria-controls="odontogramaHost" aria-label="Ver dentición adulta, 32 piezas">Adulto (<span
              id="cntAdulto">32</span>)</button>
          <button class="tipo-btn" id="btnInfantil" data-tipo="nino" role="tab" aria-selected="false"
            aria-controls="odontogramaHost" aria-label="Ver dentición infantil, 20 piezas">Infantil (<span
              id="cntInfantil">20</span>)</button>
        </div>
        <button class="btn-primary" id="btnGuardar" aria-label="Guardar cambios del odontograma">💾 Guardar
          cambios</button>
      </div>
    </header>

    <!-- Stats Grid con aria-live para contadores -->
    <section class="stats-grid" aria-label="Resumen de odontograma">
      <div class="stat-card" data-color="green">
        <span class="stat-number" id="stat-sanos" data-target="20" aria-live="polite">0</span>
        <span class="stat-label">Sanos</span>
      </div>
      <div class="stat-card" data-color="orange">
        <span class="stat-number" id="stat-caries" data-target="5" aria-live="polite">0</span>
        <span class="stat-label">Con caries</span>
      </div>
      <div class="stat-card" data-color="purple">
        <span class="stat-number" id="stat-tratamientos" data-target="8" aria-live="polite">0</span>
        <span class="stat-label">Tratados</span>
      </div>
      <div class="stat-card" data-color="blue">
        <span class="stat-number" id="stat-total" data-target="32" aria-live="polite">0</span>
        <span class="stat-label">Total piezas</span>
      </div>
    </section>

    <!-- Content Grid: Odontograma + Panel derecho -->
    <div class="content-grid">

      <!-- Sección principal: Odontograma holográfico -->
      <section class="odontograma-section" aria-labelledby="odontograma-title">

        <!-- Widget odontograma con role img para screen readers -->
        <div class="odontograma-widget" aria-labelledby="odontograma-widget-title">
          <h2 class="widget-title" id="odontograma-widget-title">🦷 Odontograma interactivo</h2>
          <div id="odontogramaHost" role="img" aria-labelledby="odontograma-widget-title"
            aria-label="Odontograma digital interactivo: haz clic en un diente para seleccionar y cambiar su estado">
          </div>

          <!-- Resumen de estados con aria-live para actualizaciones -->
          <div class="odo-resumen" id="odoResumen" aria-live="polite" role="status"></div>
        </div>

        <!-- Panel de pieza seleccionada con aria-live -->
        <div class="card card-pieza" id="cardPieza" style="display:none;" aria-labelledby="pieza-title"
          aria-live="polite">
          <h3 class="card-title" id="pieza-title">
            <span class="pieza-pin" aria-hidden="true">📍</span>
            <span id="piezaTitulo">Pieza seleccionada</span>
          </h3>
          <div class="pieza-estado" id="piezaEstado" role="status"></div>
          <div class="pieza-hist-title">Historial de cambios</div>
          <div class="pieza-hist" id="piezaHist" role="list" aria-label="Historial de cambios de esta pieza"></div>
        </div>

      </section>

      <!-- Panel derecho: Estados + Modificaciones -->
      <aside class="right-panel" aria-label="Herramientas de odontograma">

        <!-- Widget: Cambiar estado con role radiogroup -->
        <div class="widget" aria-labelledby="estados-title">
          <h3 class="widget-title" id="estados-title">⚙️ Cambiar estado del diente</h3>
          <p class="widget-sub">Selecciona un diente y asigna su estado:</p>
          <div class="estados-list" id="estadosList" role="radiogroup"
            aria-label="Estados disponibles para el diente seleccionado"></div>
        </div>

        <!-- Widget: Últimas modificaciones con aria-live -->
        <div class="widget" aria-labelledby="mods-title">
          <h3 class="widget-title" id="mods-title">🕐 Últimas modificaciones</h3>
          <div id="ultimasMods" aria-live="polite" role="list"></div>
        </div>

      </aside>
    </div>

  </main>

  <!-- Modal: Confirmar guardado accesible -->
  <div class="modal-overlay" id="modalGuardar" role="dialog" aria-modal="true" aria-labelledby="modalGuardarTitle"
    aria-hidden="true" inert>
    <div class="modal modal--sm">
      <button class="modal-close" id="modalGuardarClose" aria-label="Cerrar ventana de confirmación">×</button>
      <h2 class="modal-title" id="modalGuardarTitle">Confirmar guardado</h2>
      <p class="modal-desc">¿Deseas guardar los cambios realizados en el odontograma?</p>
      <div class="modal-footer">
        <button class="btn-secondary" id="modalGuardarCancel">Cancelar</button>
        <button class="btn-primary" id="modalGuardarConfirm">Sí, guardar</button>
      </div>
    </div>
  </div>

  <!-- Mobile bottom nav con aria-label -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-profesionales/st-odo-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">🏠</span>
      <span>Dashboard</span>
    </a>
    <a href="/gestion-de-citas/st-odo-02-agenda" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📅</span>
      <span>Agenda</span>
    </a>
    <a href="/historia-clinica/st-odo-06-pacientes" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">👥</span>
      <span>Pacientes</span>
    </a>
    <a href="/historia-clinica/st-odo-03-historial" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📋</span>
      <span>Historial</span>
    </a>
    <a href="/gestion-de-profesionales/st-odo-09-perfil-profesional"
      class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">👤</span>
      <span>Perfil</span>
    </a>
  </nav>

  <!-- Toast para notificaciones accesibles -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para contenido solo accesible por screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <script src="@Url.Content("~/js/Historia_Clinica/st-odo-04-odontograma/odontograma-digital.js")"></script>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;">🦷</span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.nav-group-header').forEach(header => {
      const items = header.nextElementSibling;
      const arrow = header.querySelector('.nav-arrow');

      if (!items || !arrow) return;

      const setExpanded = (isExpanded) => {
        items.style.maxHeight = isExpanded ? `${items.scrollHeight}px` : '0px';
        arrow.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
        header.setAttribute('aria-expanded', String(isExpanded));
      };

      setExpanded(false);

      const toggle = () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        setExpanded(!isExpanded);
      };

      header.addEventListener('click', toggle);
      header.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  });
</script>

</body>

</html>
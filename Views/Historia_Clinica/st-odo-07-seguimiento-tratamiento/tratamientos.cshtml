@{ Layout = null; }

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SmileTrack — Seguimiento de Tratamientos</title>
  <meta name="description" content="Seguimiento de tratamientos dentales en curso, completados y pausados." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Syne:wght@600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="@Url.Content("~/css/Historia_Clinica/st-odo-07-seguimiento-tratamiento/tratamientos.css")" />
</head>

<body>

  <!-- Enlace para saltar al contenido principal (accesibilidad) -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  @{ await Html.RenderPartialAsync("_SidebarProfesional"); }

  <!-- ═════ HAMBURGER (móvil) ═════ -->
  <button class="hamburger" id="hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="sidebar">
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
    <span aria-hidden="true"></span>
  </button>
  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <!-- ═════ MAIN ═════ -->
  <main class="main" id="main-content">

    <!-- Header -->
    <header class="page-header">
      <div class="header-left">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <span>Odontólogo</span>
          <span class="bc-sep" aria-hidden="true">→</span>
          <span class="bc-active">Seguimiento de Tratamientos</span>
        </nav>
        <h1 class="page-title">Historia Clínica</h1>
        <p class="page-subtitle" id="pageSub" aria-live="polite">
          Pedro García · CC 1045678901 · 34 años · O+
        </p>
      </div>
    </header>

    <!-- Sección de tratamientos -->
    <section class="section" aria-labelledby="tratamientosTitle">
      <h2 class="section-title" id="tratamientosTitle">Historial de tratamientos</h2>

      <!-- Filtros de estado con role tablist para accesibilidad -->
      <div class="filter-tabs" id="filterTabs" role="tablist" aria-label="Filtrar tratamientos por estado">
        <button class="ftab active" data-filter="en-curso" role="tab" aria-selected="true"
          aria-controls="tratamientosList">
          En curso (<span id="cntCurso" aria-live="polite">0</span>)
        </button>
        <button class="ftab" data-filter="completado" role="tab" aria-selected="false" aria-controls="tratamientosList">
          Completado (<span id="cntCompletado" aria-live="polite">0</span>)
        </button>
        <button class="ftab" data-filter="pausado" role="tab" aria-selected="false" aria-controls="tratamientosList">
          Pausado (<span id="cntPausado" aria-live="polite">0</span>)
        </button>
      </div>

      <!-- Lista de tratamientos con aria-live para actualizaciones -->
      <div id="tratamientosList" aria-live="polite" role="list" aria-label="Lista de tratamientos">
        <!-- JS renderiza aquí -->
      </div>

      <!-- Estado vacío accesible -->
      <div class="empty-state" id="emptyState" style="display:none" role="status" aria-live="polite" aria-hidden="true">
        Sin tratamientos en esta categoría.
      </div>
    </section>

  </main>

  <!-- Mobile bottom nav -->
  <nav class="mobile-nav" aria-label="Navegación móvil">
    <a href="/gestion-de-profesionales/st-odo-01-dashboard" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">🏠</span>
      <span>Dashboard</span>
    </a>
    <a href="/gestion-de-citas/st-odo-02-agenda" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📅</span>
      <span>Agenda</span>
    </a>
    <a href="/historia-clinica/st-odo-06-pacientes" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">👥</span>
      <span>Pacientes</span>
    </a>
    <a href="/historia-clinica/st-odo-03-historial" class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">📋</span>
      <span>Historial</span>
    </a>
    <a href="/gestion-de-profesionales/st-odo-09-perfil-profesional"
      class="mobile-nav-item">
      <span class="mobile-nav-icon" aria-hidden="true">👤</span>
      <span>Perfil</span>
    </a>
  </nav>

  <!-- Toast -->
  <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>

  <!-- Estilos para screen readers -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: var(--primary);
      color: #fff;
      padding: 8px 16px;
      z-index: 1000;
      transition: top var(--tr);
    }

    .skip-link:focus {
      top: 0;
      outline: 2px solid #fff;
      outline-offset: 2px;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>
  <script src="@Url.Content("~/js/Historia_Clinica/st-odo-07-seguimiento-tratamiento/tratamientos.js")"></script>

  <footer id="dynamic-footer" class="site-footer" role="contentinfo">
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <span style="font-size:1rem;">🦷</span>
      <p>© 2025 Smile Track. Todos los derechos reservados.</p>
    </div>
    <p class="footer-sub">Proyecto Formativo ADSO – SENA</p>
    <script src="@Url.Content("~/js/footer.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/footer.css")">
  </footer>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.nav-group-header').forEach(header => {
      const items = header.nextElementSibling;
      const arrow = header.querySelector('.nav-arrow');

      if (!items || !arrow) return;

      const setExpanded = (isExpanded) => {
        items.style.maxHeight = isExpanded ? `${items.scrollHeight}px` : '0px';
        arrow.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(-90deg)';
        header.setAttribute('aria-expanded', String(isExpanded));
      };

      setExpanded(false);

      const toggle = () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        setExpanded(!isExpanded);
      };

      header.addEventListener('click', toggle);
      header.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  });
</script>

</body>

</html>

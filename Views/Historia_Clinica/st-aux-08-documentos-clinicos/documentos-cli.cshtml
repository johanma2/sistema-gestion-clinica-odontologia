              </div>
              <button class="doc-eye" onclick="viewDocument('foto.jpg','Fotografía inicial')"
                aria-label="Ver documento">👁️</button>
            </div>
            <div class="doc-item">
              <span class="doc-icon">🧪</span>
              <div class="doc-info">
                <p class="doc-name">Examen de coagulación</p>
                <p class="doc-meta">02 Nov 2025 · Auxiliar: Sara Jiménez</p>
              </div>
              <button class="doc-eye" onclick="viewDocument('examen.pdf','Examen de coagulación')"
                aria-label="Ver documento">👁️</button>
            </div>
          </div>
        </div>
      </aside>

